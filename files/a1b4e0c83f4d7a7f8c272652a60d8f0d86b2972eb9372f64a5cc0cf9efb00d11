const o={arizona:[{id:"monument-valley-navajo-tribal-park",name:"Monument Valley Navajo Tribal Park",designation:"Tribal Park",image:"https://kosher-travel-img.sites.tab.bot/wm/33224476f4812d10.webp",photoGallery:[],shortDescription:"World-famous red sandstone buttes and sacred Navajo landscapes immortalized in classic cinema.",fullDescription:"Monument Valley Navajo Tribal Park straddles the Arizona-Utah border on the sacred ancestral lands of the Navajo Nation (Diné). Towering sandstone monoliths, buttes, and spires rise between 400 and 1,000 feet above the vibrant desert floor. Visitors can drive the legendary 17-mile unpaved Valley Drive or hire licensed Navajo guides to access sacred backcountry areas like Mystery Valley, Hunts Mesa, and Ear of the Wind.",thingsToDo:["Drive the 17-Mile Scenic Dirt Loop","Take a Certified Navajo Guided 4x4 Tour","Hike the Wildcat Trail around West Mitten Butte","Photograph Sunset and Sunrise at the View Hotel Overlook","Visit Navajo Hogan Demonstrations and Artisan Stands"],hikingTrails:[{name:"Wildcat Trail",difficulty:"Moderate",length:"3.2 miles loop",description:"The only self-guided hiking trail in the park, circling around the iconic West Mitten Butte with spectacular ground-level views of the Mittens and Merrick Butte."},{name:"Mystery Valley Backcountry Tour (Guided Only)",difficulty:"Moderate",length:"4.0 miles",description:"Accessible only with licensed Navajo guides, leading to ancient Anasazi cliff dwellings, pictographs, petroglyphs, and secluded natural arches."}],scenicDrives:[{name:"17-Mile Valley Drive",length:"17.0 miles",description:"A graded dirt road passing the East and West Mitten Buttes, Merrick Butte, Three Sisters, John Ford Point, Totem Pole, and Artist Point."},{name:"US-163 Scenic Byway (Forrest Gump Point)",length:"13.0 miles",description:"The iconic highway straightaway with panoramic head-on views of Monument Valley buttes made famous in the film Forrest Gump."}],visitorCenter:{name:"Monument Valley Visitor Center",info:"Features an observation deck, Navajo cultural exhibits, restaurant, and gift shop with authentic Navajo silversmithing and rugs.",phone:"(435) 727-5870",hours:"Peak Season (May 1 – Sep 30): 6:00 AM – 8:00 PM; Off-Peak (Oct 1 – Apr 30): 8:00 AM – 5:00 PM"},campingInfo:"The View Campground offers primitive wilderness campsites and RV sites overlooking the valley. Gouldings Resort & Campground (5 miles west) provides full hookups, cabins, and indoor pool.",wildlife:["Desert Bighorn Sheep","Coyotes","Golden Eagles","Ravens","Black-tailed Jackrabbits"],bestViewpoints:["John Ford Point","Artist Point","The View Hotel Terrace","North Window Overlook","Forrest Gump Hill (Mile Marker 13 on US-163)"],entranceFees:"$8.00 per person entry fee. Children 9 and under are free. (National Park America the Beautiful passes are not accepted on sovereign tribal land).",hours:"Open 7 days a week year-round; Valley Drive closes to entry 2 hours before park gates close.",address:"Indn Route 42, Oljato-Monument Valley, AZ 84536",googleMapsLocation:"https://maps.google.com/?q=Monument+Valley+Navajo+Tribal+Park+36.9830,-110.1115",officialWebsite:"https://navajonationparks.org/tribal-parks/monument-valley/",bestTimeToVisit:"Spring (April to May) and Autumn (September to October) for pleasant daytime temperatures and striking desert sunset lighting.",accessibilityInfo:"The Visitor Center, observation terrace, and The View Hotel are fully ADA accessible. Valley Drive is a rough dirt road; trails are sandy and non-paved.",travelTips:["Sovereign Tribal Land: Alcohol is strictly prohibited across the Navajo Nation.","Photography Rules: Commercial filming requires permits. Always request permission before photographing local Navajo artisans and residents.","High Clearance Recommended: Valley Drive is rough washboard dirt with deep ruts; low-clearance sedans may scrape.","Nearest Staging Towns: Kayenta, AZ (23 miles south) and Mexican Hat / Bluff, UT (22–45 miles north)."],nearbyAttractions:["Goosenecks State Park","Valley of the Gods","Four Corners Monument","Canyon de Chelly National Monument"]},{id:"antelope-canyon-tribal-park",name:"Antelope Canyon (Upper & Lower)",designation:"Tribal Park",image:"https://kosher-travel-img.sites.tab.bot/wm/6540aaf9a5623f27.webp",photoGallery:[],shortDescription:"Mesmerizing sandstone slot canyons known for glowing sunbeams, flowing wave-like curves, and deep Navajo cultural significance.",fullDescription:'Antelope Canyon (Tsé bighánílíní - "the place where water runs through rocks" in Navajo) is the most famous slot canyon system in the world. Located near Page, Arizona, within the LeChee Chapter of the Navajo Nation, the canyon is split into two distinct sections: Upper Antelope Canyon (famous for vertical midday light shafts in summer) and Lower Antelope Canyon (renowned for metal stairs, dynamic climb-through passages, and swirling sculptured sandstone). Access is strictly restricted to licensed Navajo guided tours.',thingsToDo:["Book a Guided Tour of Upper Antelope Canyon for Midday Sunbeams","Climb through the Sculpted Passages of Lower Antelope Canyon","Experience Canyon X and Secret Antelope for Lower Crowds","Capture Iconic Swirling Sandstone Textures and Color Gradients","Learn Navajo Heritage and Geologic History from Native Guides"],hikingTrails:[{name:"Upper Antelope Canyon Tour Walk",difficulty:"Easy",length:"0.25 miles each way",description:"A flat, sandy walk through narrow 120-foot tall canyon corridors with dramatic overhead light shafts (guided access only)."},{name:"Lower Antelope Canyon Trek",difficulty:"Moderate",length:"0.5 miles one-way",description:"Navigates multiple flights of steep metal staircases and narrow sandstone crevices, exiting via a flat overland walkway."}],scenicDrives:[{name:"AZ-98 Scenic Desert Highway",length:"25.0 miles",description:"Connects Page, AZ to Kaibeto, passing Antelope Canyon tour staging areas and panoramic desert sandstone mesas."}],visitorCenter:{name:"Navajo Nation Lake Powell Tribal Parks Office",info:"Manages permits and oversight for Antelope Canyon, Horseshoe Bend overlook lands, and Lake Powell tribal shorelines.",phone:"(928) 645-9130",hours:"Monday – Friday: 8:00 AM – 5:00 PM"},campingInfo:"No camping inside the canyon. Extensive camping and RV resorts are available 10 minutes away at Wahweap Marina (Lake Powell) and Page, AZ.",wildlife:["Desert Cottontails","Ravens","Great Horned Owls","Collared Lizards"],bestViewpoints:["The Sunbeam Chambers (Upper Antelope, 10:30 AM - 1:00 PM May-Sep)","The Lady in the Wind (Lower Antelope)","The Chief Formation"],entranceFees:"$8.00 Navajo Nation Park Entry Permit + Tour Operator Ticket ($70 - $120+ per person depending on operator and season).",hours:"Guided tours depart daily between 7:30 AM and 4:30 PM (weather permitting).",address:"Indn Route 222, Page, AZ 86040",googleMapsLocation:"https://maps.google.com/?q=Antelope+Canyon+Page+AZ+36.8619,-111.3743",officialWebsite:"https://navajonationparks.org/guided-tour-operators/antelope-canyon-tour-operators/",bestTimeToVisit:"May through September for the famous overhead light shafts; October through April for cooler weather and fewer crowds.",accessibilityInfo:"Upper Antelope Canyon is level on sand but bumpy 4x4 ride is required; Lower Antelope Canyon features steep metal stairs and is not wheelchair accessible.",travelTips:["Advance Booking Required: Tours sell out weeks to months in advance, especially during peak spring/summer months.","Strict Bag Policy: Bags, backpacks, and tripods are strictly prohibited by tour operators for safety and space constraints inside the slots.","Flash Flood Closures: Slot canyons can close immediately with zero warning if rainfall occurs anywhere upstream in the watershed.","Time Zone Note: Page and Navajo Nation time zones can differ depending on Daylight Saving Time—verify tour check-in time with operator."],nearbyAttractions:["Horseshoe Bend","Lake Powell & Glen Canyon Dam","The Wave (Vermilion Cliffs)","Waterholes Canyon"]},{id:"havasu-falls-tribal-recreation-area",name:"Havasu Falls & Mooney Falls",designation:"Tribal Recreation Area",image:"https://kosher-travel-img.sites.tab.bot/wm/6253f29c69b895db.webp",photoGallery:[],shortDescription:"World-renowned turquoise waterfalls plunging into travertine pools on the sovereign sovereign Havasupai Indian Reservation.",fullDescription:"Havasu Falls is the crown jewel of Havasu Canyon on the Havasupai Indian Reservation, located within a remote tributary of the Grand Canyon. Fed by underground mineral springs that deposit calcium carbonate, the crystal-clear waters shine in vivid shades of turquoise and aquamarine contrasting sharply against red sandstone amphitheaters. The area includes Navajo Falls, Fifty Foot Falls, Havasu Falls, Mooney Falls (200 ft), and Beaver Falls.",thingsToDo:["Backpack the 10-Mile Canyon Trail from Hualapai Hilltop to Supai Village","Swim in the Brilliant Travertine Pools beneath Havasu Falls","Descend the Thrilling Rock Tunnel and Chains to the Base of Mooney Falls","Trek Down-Canyon to Beaver Falls through Cottonwood Groves","Sample Fresh Traditional Frybread in Supai Village"],hikingTrails:[{name:"Hualapai Hilltop to Supai Village & Campground",difficulty:"Strenuous",length:"10.0 miles one-way (2,000 ft elevation change)",description:"A desert hike through switchbacks into canyon beds leading to Supai Village (mile 8) and Havasu Falls Campground (mile 10)."},{name:"Mooney Falls to Beaver Falls Hike",difficulty:"Strenuous",length:"3.0 miles one-way (6.0 miles RT)",description:"Includes descending Mooney chains and ladders, multiple waist-deep river crossings, and lush canyon paths to Beaver Falls cascade."}],scenicDrives:[{name:"Indian Road 18 to Hualapai Hilltop",length:"63.0 miles",description:"Remote paved highway branching north from Route 66 across the high desert plateau to the trailhead overlook at Hualapai Hilltop."}],visitorCenter:{name:"Havasupai Tourism & Check-in Office",info:"All visitors must check in at the Tourism Office in Supai Village with valid reservation confirmation, photo ID, and permit tags.",phone:"(928) 448-2121",hours:"Daily: 8:00 AM – 5:00 PM"},campingInfo:"Campground permit includes a 3-night / 4-day reservation alongside Havasu Creek between Havasu Falls and Mooney Falls. Spring water and composting toilets provided.",wildlife:["Desert Bighorn Sheep","Mule Deer","Ringtail Cats","Canyon Tree Frogs","Humpback Chub"],bestViewpoints:["Havasu Falls Vista","Mooney Falls Descent Overlook","Upper Navajo Falls","Beaver Falls Cascades"],entranceFees:"Multi-night campground reservations are mandatory (approximately $395 – $455 per person for the mandatory 3-night package). No day hiking allowed.",hours:"Open to confirmed permit holders only; trailhead open 24 hours for registered permit holders.",address:"Hualapai Hilltop, Supai, AZ 86435",googleMapsLocation:"https://maps.google.com/?q=Hualapai+Hilltop+Trailhead+35.9644,-112.7092",officialWebsite:"https://www.havasupaireservations.com/",bestTimeToVisit:"Spring (April to May) and Fall (September to October) for warm swimming weather without dangerous mid-summer triple-digit heat.",accessibilityInfo:"Not wheelchair accessible. Strenuous 10-mile hike or pre-booked tribal helicopter transport (space-available basis for visitors).",travelTips:["Strict Multi-Day Commitment: Mandatory 3 nights / 4 days. Absolutely no day hiking allowed.","Extreme Remoteness & Zero Connectivity: There is zero cell service at Hualapai Hilltop, throughout the canyon, and in Supai village.","Permit Release: Annual permits open every February 1 at 8:00 AM MST and sell out within minutes on the official website.","No Services on Road 18: Fill gas tanks in Peach Springs, Seligman, or Kingman before turning onto Indian Road 18 (no gas for 65+ miles)."],nearbyAttractions:["Grand Canyon West Skywalk","Route 66 Peach Springs","Grand Canyon Caverns"]},{id:"the-wave-coyote-buttes-north",name:"The Wave (Coyote Buttes North)",designation:"BLM Wilderness",image:"https://kosher-travel-img.sites.tab.bot/wm/84243fc3147eb738.webp",photoGallery:[],shortDescription:"One of Earth’s most surreal geological wonders featuring undulating Navajo sandstone troughs sculpted by Jurassic winds and water.",fullDescription:"The Wave is a world-famous Jurassic-age sandstone rock formation located in the Paria Canyon-Vermilion Cliffs Wilderness on the Arizona-Utah border. Delicate intersecting troughs with swirling stripes of red, orange, pink, and yellow create an optical illusion resembling ocean waves frozen in stone. Due to the fragile nature of the sandstone and extreme desert environment, the Bureau of Land Management strictly limits entry to 64 people per day through a competitive lottery.",thingsToDo:["Navigate the Untracked 6.4-Mile Wilderness Route to The Wave","Photograph the Swirling Sandstone Curves and Reflections in Rain Pools","Explore The Second Wave, Sand Cove, and The Alcove Formations","Visit Dinosaur Tracks Pressed in Jurassic Sandstone Layers","Scramble to Top Rock and The Melody Arch Natural Window"],hikingTrails:[{name:"Wire Pass Trailhead to The Wave",difficulty:"Strenuous",length:"6.4 miles RT (Cross-Country Route)",description:"No marked trail; requires navigating via GPS coordinates and photo-guide landmarks across open desert, wash beds, and slickrock ridges."}],scenicDrives:[{name:"House Rock Valley Road",length:"30.0 miles",description:"Unpaved dirt road passing along the base of the Vermilion Cliffs, connecting US-89 in Utah to US-89A in Arizona."}],visitorCenter:{name:"Kanab BLM Visitor Center / Paria Contact Station",info:"Provides daily wilderness briefings, topographic route maps, daily lotteries, and road conditions for Vermilion Cliffs.",phone:"(435) 688-3200",hours:"Daily: 8:00 AM – 4:30 PM (March – November)"},campingInfo:"No camping allowed within Coyote Buttes North. Dispersed BLM camping is permitted along House Rock Valley Road at Stateline Campground (primitive, free).",wildlife:["Desert Bighorn Sheep","California Condors","Coyotes","Mojave Green Rattlesnakes","Horned Lizards"],bestViewpoints:["The Main Wave Bowl","The Second Wave (Best at Late Afternoon)","Melody Arch / The Alcove","Top Rock Sandstone Window"],entranceFees:"Strict Lottery Permit Required ($9.00 per person permit fee + $9.00 application fee via Recreation.gov). No non-permit access allowed.",hours:"Open 24 hours for confirmed permit holders with day-use privileges.",address:"House Rock Valley Rd, Marble Canyon, AZ 86036",googleMapsLocation:"https://maps.google.com/?q=The+Wave+Coyote+Buttes+North+36.9960,-112.0060",officialWebsite:"https://www.blm.gov/programs/recreation/permits-and-passes/lotteries-and-permit-systems/arizona/coyote-buttes-north",bestTimeToVisit:"Spring (April to May) and Autumn (September to October). Summer temperatures routinely exceed 100°F with zero shade.",accessibilityInfo:"Strictly wilderness terrain with deep sand, steep slickrock, and zero trail markers. Not accessible.",travelTips:["Lottery Requirements: Two lotteries exist: the Advanced Lottery (4 months in advance) and Daily Geofence Lottery (2 days prior via Recreation.gov mobile app).","Navigation Hazard: There is NO established trail. Every year hikers get lost in extreme heat; bring GPS device and power bank.","Water Requirements: Carry a minimum of 4 to 5 liters of water per person (no natural water sources exist).","Road Hazard: House Rock Valley Road turns into impassable slick mud during rain storms; high-clearance 4WD recommended."],nearbyAttractions:["Buckskin Gulch","White Pocket","Coral Pink Sand Dunes State Park","Horseshoe Bend"]},{id:"white-pocket-vermilion-cliffs",name:"White Pocket & Coyote Buttes South",designation:"BLM Wilderness",image:"https://kosher-travel-img.sites.tab.bot/wm/6a42b4d1f48f44f2.webp",photoGallery:[],shortDescription:"A mind-bending wonderland of twisted, brain-like white and candy-red slickrock formations deep in the Vermilion Cliffs.",fullDescription:"White Pocket is an isolated, otherworldly expanse of contorted, brain-textured Navajo sandstone located in the remote depths of Vermilion Cliffs National Monument in northern Arizona. Unlike The Wave, White Pocket currently requires no advance lottery permit. The swirling layers of white calcium-rich rock overlaying fiery red, orange, and purple sandstone create one of the most visually stunning and photogenic natural landscapes on the continent.",thingsToDo:["Explore the Mind-Blowing Brain Rocks and Twisted White Formations","Photograph Sunrise and Sunset over Cauliflower Formations and Desert Water Pockets","Experience True Deep Wilderness Solitude Far from Paved Roads","Stargaze under Class 1 Bortle Dark Sky Sanctuary","Scramble Across Multi-Colored Slickrock Domes and Natural Potholes"],hikingTrails:[{name:"White Pocket Exploration Loop",difficulty:"Moderate",length:"1.5 to 3.0 miles (Open Exploration)",description:"No defined trail; visitors wander freely across approximately 1 square mile of surreal slickrock domes, swirling channels, and solitary hoodoos."}],scenicDrives:[{name:"Pine Tree Road / BLM Road 1087 Deep Sand Trail",length:"22.0 miles",description:"Extremely rugged deep-sand 4WD backcountry route traversing the Paria Plateau to the White Pocket trailhead."}],visitorCenter:{name:"Paria Contact Station / BLM Kanab Office",info:"Provides road condition updates, deep-sand advisories, and maps for the Paria Plateau.",phone:"(435) 688-3200",hours:"Daily: 8:00 AM – 4:30 PM"},campingInfo:"Dispersed wilderness dry-camping allowed at the White Pocket trailhead and across BLM public lands. No water, no trash cans; pack out all waste.",wildlife:["California Condors","Pronghorn Antelope","Kit Foxes","Desert Bighorn Sheep","Golden Eagles"],bestViewpoints:["The White Pocket Cauliflower Domes","The Lone Tree Pothole","The Swirling Amphitheater","The Yellow Rock Spires"],entranceFees:"Free entry for White Pocket (no permit currently required). Coyote Buttes South requires a BLM Day-Use Permit ($5.00/person).",hours:"Open 24 hours daily year-round.",address:"BLM Road 1087, Marble Canyon, AZ 86036",googleMapsLocation:"https://maps.google.com/?q=White+Pocket+Trailhead+36.9580,-111.9030",officialWebsite:"https://www.blm.gov/national-conservation-lands/arizona/vermilion-cliffs",bestTimeToVisit:"October through May. Summer temperatures are dangerously scorching with high risk of vehicle overheating in deep sand.",accessibilityInfo:"Remote backcountry desert with deep sand and slickrock; not wheelchair accessible.",travelTips:["Mandatory True 4WD: A high-clearance 4WD vehicle with low-range transfer case is mandatory. All-wheel-drive (AWD) crossovers get stuck regularly in deep sand ruts.","Tire Deflation: Air down tires to 15–18 PSI for deep sand navigation; bring a portable 12V air compressor to reinflate.","Towing Cost: Backcountry vehicle recovery from White Pocket costs upwards of $1,500–$2,500 due to extreme isolation.","Zero Connectivity: Zero cellular service across the entire Paria Plateau; carry satellite communicator (Garmin inReach)."],nearbyAttractions:["The Wave","Buckskin Gulch","Lee's Ferry & Marble Canyon","Horseshoe Bend"]},{id:"horseshoe-bend-scenic-overlook",name:"Horseshoe Bend Scenic Overlook",designation:"Scenic Natural Landmark",image:"https://kosher-travel-img.sites.tab.bot/wm/2217e915b4e94bac.webp",photoGallery:[],shortDescription:"A breathtaking 270-degree horseshoe-shaped meander of the Colorado River carved 1,000 feet below sandstone canyon rims.",fullDescription:"Horseshoe Bend is a dramatic incised river meander located 5 miles downstream from Glen Canyon Dam and Lake Powell, just outside Page, Arizona. Standing on the sheer 1,000-foot sandstone rim, visitors look directly down at the emerald-green Colorado River making a sweeping 270-degree turn around a massive sandstone promontory.",thingsToDo:["Walk the Wide ADA Accessible Pathway to the Canyon Edge","Photograph the Emerald Colorado River 1,000 Feet Below","Watch Kayakers and Rafts Navigating the Deep Canyon Meander","Witness Spectacular Sunset Glow illuminating the Curved Walls","Relax at the Shaded Viewing Pavilions along the Trail"],hikingTrails:[{name:"Horseshoe Bend Trail",difficulty:"Easy",length:"1.5 miles round-trip",description:"A smooth, graded, ADA-accessible gravel/paved pathway with two shade structures leading from the parking lot to the viewing rim."}],scenicDrives:[{name:"US-89 South Scenic Corridor",length:"10.0 miles",description:"Connects Page to the Grand Canyon South Rim and Flagstaff, passing the Echo Cliffs and high desert plateau."}],visitorCenter:{name:"Horseshoe Bend Information Center & Plaza",info:"Features staffed parking kiosks, restrooms, shade structures, and safety information run by the City of Page.",phone:"(928) 645-8861",hours:"Open Sunrise to Sunset daily"},campingInfo:"No camping at Horseshoe Bend overlook. Extensive camping is available 15 minutes away at Wahweap Marina Campground on Lake Powell.",wildlife:["Peregrine Falcons","California Condors","Ravens","Desert Cottontails","Chuckwallas"],bestViewpoints:["Horseshoe Bend Main Viewing Platform (Fenced)","East and West Unfenced Natural Rim Outcrops"],entranceFees:"$10.00 per standard passenger vehicle parking fee (City of Page managed facility; NPS America the Beautiful pass does not cover parking).",hours:"Open daily from sunrise to sunset (gates open 30 minutes before sunrise and close 30 minutes after sunset).",address:"US-89, Page, AZ 86040",googleMapsLocation:"https://maps.google.com/?q=Horseshoe+Bend+Page+AZ+36.8790,-111.5105",officialWebsite:"https://cityofpage.org/horseshoe-bend",bestTimeToVisit:"Early morning for calm viewing and mid-day for direct sunlight penetrating the river floor, or sunset for vibrant sky colors.",accessibilityInfo:"Fully ADA-compliant path and fenced overlook platform suitable for wheelchairs and strollers.",travelTips:["Extreme Heat Warning: Temperatures routinely reach 105°F+ in summer; bring water and sun protection despite the short walk.","Rim Safety: Beyond the central fenced railing, the cliffs are 1,000-foot sheer vertical drops with friable sandstone edges; watch children carefully.","Drone Prohibition: Operating drones at Horseshoe Bend is illegal under Glen Canyon National Recreation Area regulations.","Staging Town: Page, Arizona is 5 minutes away with full hotels, restaurants, gas, and groceries."],nearbyAttractions:["Antelope Canyon","Glen Canyon Dam & Lake Powell","Waterholes Canyon","Lee's Ferry"]},{id:"four-corners-monument-navajo-tribal-park",name:"Four Corners Monument Navajo Tribal Park",designation:"Tribal Park",image:"https://kosher-travel-img.sites.tab.bot/venues/park-four-corners-monument-navajo-tribal-park-arizona.webp",photoGallery:[],shortDescription:"The only geographic point in the United States where four sovereign states (AZ, UT, CO, NM) meet at a single marker.",fullDescription:"Four Corners Monument Navajo Tribal Park marks the unique intersection where the boundaries of Arizona, Utah, Colorado, and New Mexico converge at a single bronze disc. Situated on sovereign land shared by the Navajo Nation and the Ute Mountain Ute Tribe, visitors can stand in four states simultaneously while browsing open-air artisan booths featuring authentic Native American jewelry, pottery, rugs, and traditional foods like Navajo tacos and frybread.",thingsToDo:["Stand in Four US States Simultaneously at the Center Bronze Marker","Shop Handcrafted Silver & Turquoise Jewelry from Navajo and Ute Artisans","Taste Fresh Warm Navajo Frybread and Green Chile Tacos","Learn about Navajo Nation and Ute Tribal Cultural Boundaries","Photograph the State Boundary Lines and Flags"],hikingTrails:[{name:"Monument Plaza Perimeter Walk",difficulty:"Easy",length:"0.2 miles loop",description:"A level concrete walkway around the central monument disc and surrounding vendor booths and state flag displays."}],scenicDrives:[{name:"US-160 Four Corners Highway",length:"40.0 miles",description:"Traverses scenic red-rock and open desert badlands connecting Kayenta, AZ to Cortez, CO."}],visitorCenter:{name:"Four Corners Visitor Pavilion",info:"Open-air demonstration plaza with Native American craft vendor booths, picnic tables, and restroom facilities.",phone:"(928) 871-6647",hours:"Peak Season (May 27 – Aug 19): 8:00 AM – 6:45 PM; Fall/Winter: 8:00 AM – 4:45 PM"},campingInfo:"No camping inside the monument plaza. RV and tent camping available in nearby Cortez, CO (40 miles) or Bluff, UT (50 miles).",wildlife:["Desert Cottontails","Horned Lizards","Coyotes","Ravens"],bestViewpoints:["Elevated Monument Viewing Deck","Central Bronze Quadrant Disk"],entranceFees:"$8.00 per person entry fee. Children 6 and under are free. (Cash and credit cards accepted; NPS passes not valid).",hours:"Open 7 days a week year-round (hours adjust seasonally; last entry 15 minutes before gate closing).",address:"597 NM-597, Teec Nos Pos, AZ 86514",googleMapsLocation:"https://maps.google.com/?q=Four+Corners+Monument+36.9990,-109.0452",officialWebsite:"https://navajonationparks.org/tribal-parks/four-corners-monument/",bestTimeToVisit:"Spring and Autumn for mild temperatures; visit early in the morning to avoid midday photo lines.",accessibilityInfo:"Fully paved and ramp-accessible plaza with level walkways around the marker and vendor booths.",travelTips:["Cash Recommended: While the entry gate accepts credit cards, many independent artisan craft booths are cash-only.","Remote Isolation: No running water or gas station at the monument; fill gas in Teec Nos Pos, AZ (6 miles) or Shiprock, NM (33 miles).","No Cell Service: Connectivity is very weak or nonexistent at the monument plaza.","Visit Duration: Most visitors spend 45–60 minutes to take photos, browse artisan crafts, and enjoy frybread."],nearbyAttractions:["Mesa Verde National Park","Monument Valley","Shiprock Peak","Canyon of the Ancients"]},{id:"buckskin-gulch-paria-canyon",name:"Buckskin Gulch & Paria Canyon",designation:"BLM Wilderness",image:"https://kosher-travel-img.sites.tab.bot/wm/836f6595b67bca7f.webp",photoGallery:[],shortDescription:"The longest and deepest continuous slot canyon in the world, spanning over 15 miles of towering sandstone narrows.",fullDescription:"Buckskin Gulch is recognized as the longest and deepest slot canyon on Earth. Located within the Paria Canyon-Vermilion Cliffs Wilderness on the Utah-Arizona border, the canyon narrows into a dark, serpentine sandstone corridor reaching up to 500 feet deep and often just a few feet wide.",thingsToDo:["Hike the Wire Pass Shortcut into the Deep Narrows of Buckskin Gulch","Photograph the Ancient Native American Petroglyph Panel at the Confluence","Wade Through Mysterious Water Cesspools and Sandstone Chambers","Backpack the Epic 21-Mile Multi-Day Wilderness Trek to Lee's Ferry","Experience Towering 500-Foot Vertical Sandstone Canyon Walls"],hikingTrails:[{name:"Wire Pass to Buckskin Gulch Confluence",difficulty:"Moderate",length:"3.4 miles RT",description:"The most popular day hike entering via Wire Pass slot (with a short 8-foot wooden ladder) reaching the petroglyphs and confluence with main Buckskin Gulch."}],scenicDrives:[{name:"House Rock Valley Road",length:"30.0 miles",description:"Unpaved dirt access road leading to Wire Pass, Buckskin, and Stateline trailheads along the Vermilion Cliffs."}],visitorCenter:{name:"Kanab BLM Visitor Center",info:"Provides mandatory flash flood risk reports, weather alerts, day-use permits, and Paria Canyon wilderness permits.",phone:"(435) 644-1200",hours:"Daily 8:00 AM – 4:30 PM (seasonal)"},campingInfo:"No camping in the narrow slot sections. Wilderness backpackers with BLM overnight permits camp along designated elevated benches in Paria Canyon.",wildlife:["Desert Bighorn Sheep","California Condors","Spotted Bats","Canyon Toads"],bestViewpoints:["Wire Pass Confluence Petroglyph Wall","Buckskin Gulch Cathedral Alcove"],entranceFees:"$6.00 per person and $6.00 per dog for day-use permits (payable at trailhead self-pay kiosk or online via Recreation.gov).",hours:"Open 24 hours daily for day-use and permit holders.",address:"House Rock Valley Rd, Kanab, UT 84741",googleMapsLocation:"https://maps.google.com/?q=Wire+Pass+Trailhead+Buckskin+Gulch+37.0194,-112.0250",officialWebsite:"https://www.blm.gov/visit/paria-canyon-vermilion-cliffs-wilderness",bestTimeToVisit:"Spring (April–May) and Autumn (September–October). Avoid during summer monsoon season (July–August).",accessibilityInfo:"Rugged wilderness slot canyon. Not wheelchair accessible.",travelTips:["Extreme Flash Flood Hazard: Never enter Buckskin Gulch if rain is forecasted anywhere in the region.","Water & Mud Gear: Expect to wade through cold mud and water pools; bring neoprene socks and trekking poles.","Zero Cell Service: No reception at the trailhead or inside the canyon.","Nearby Towns: Kanab, UT (42 miles) and Page, AZ (45 miles)."],nearbyAttractions:["The Wave","White Pocket","Coral Pink Sand Dunes State Park","Horseshoe Bend"]},{id:"little-colorado-river-gorge-navajo-tribal-park",name:"Little Colorado River Gorge Navajo Tribal Park",designation:"Tribal Park",image:"https://kosher-travel-img.sites.tab.bot/wm/eb4f329d3eba347c.webp",photoGallery:[],shortDescription:"A sheer, 3,000-foot vertical limestone abyss carved by the turquoise waters of the Little Colorado River before entering Grand Canyon.",fullDescription:"Little Colorado River Gorge Navajo Tribal Park protects an astonishing, narrow canyon chasm along AZ-64 on the Navajo Nation. Formed by the Little Colorado River slicing through layers of Kaibab limestone, the gorge plunges thousands of vertical feet with near-vertical walls. Two scenic rim overlooks provide staggering, unobstructed views into the deep abyss, while authentic Navajo artisans sell handmade jewelry and crafts along the boardwalks.",thingsToDo:["Gaze 3,000 Feet Down into the Sheer Vertical Gorge Overlook","Shop Authentic Handmade Navajo Jewelry and Pottery at the Rimside Stands","View the Vivid Turquoise River Waters (Spring and Early Summer)","Photograph Dramatic Light and Shadow across the Narrow Canyon Chasm","Enjoy a Scenic Picnic on the High Rim Overlooking the Painted Desert"],hikingTrails:[{name:"Gorge Rim Boardwalk & Overlook Walk",difficulty:"Easy",length:"0.4 miles RT",description:"A level, paved/gravel rim pathway leading from the artisan parking plaza to the metal observation deck perched directly over the canyon edge."}],scenicDrives:[{name:"AZ-64 Desert View Scenic Byway",length:"32.0 miles",description:"Connects Cameron, AZ on US-89 to Desert View and the East Entrance of Grand Canyon National Park."}],visitorCenter:{name:"Little Colorado River Tribal Park Overlook Kiosks",info:"Staffed Navajo Nation Parks & Recreation kiosks with local park guides, artisan booths, and portable restrooms.",phone:"(928) 871-6647",hours:"Daily: 8:00 AM – 5:00 PM (seasonal)"},campingInfo:"No camping at the overlooks. Camping available in Cameron, AZ (Cameron Trading Post RV Park, 10 miles) or inside Grand Canyon Desert View Campground (22 miles).",wildlife:["Golden Eagles","Ravens","Desert Bighorn Sheep","Collared Lizards","Peregrine Falcons"],bestViewpoints:["Little Colorado River Gorge Overlook 1 (Main Observation Deck)","Overlook 2 (Upper Gorge Vista)"],entranceFees:"$8.00 per vehicle / per person entry fee supporting Navajo Nation Parks (NPS passes not accepted).",hours:"Open 7 days a week from 8:00 AM to 5:00 PM (weather permitting).",address:"AZ-64 Milepost 285, Cameron, AZ 86020",googleMapsLocation:"https://maps.google.com/?q=Little+Colorado+River+Gorge+Overlook+35.9189,-111.7761",officialWebsite:"https://navajonationparks.org/navajo-tribal-parks/little-colorado-river-navajo-tribal-park/",bestTimeToVisit:"Spring and Autumn for clear skies and pleasant weather; visit during spring for turquoise mineral-rich river flow.",accessibilityInfo:"The main parking area and viewing deck walkway at Overlook 1 are wheelchair and stroller accessible.",travelTips:["Artisan Crafts: The Navajo vendors at the overlook are local artisans offering authentic handcrafted turquoise and silver jewelry at direct prices.","High Winds: The canyon rim can experience strong sudden wind gusts; hold on to hats and camera equipment.","Turquoise Water Condition: The water turns vibrant turquoise during dry periods; heavy rain turns it silt-brown temporarily.","Nearest Staging Towns: Cameron, AZ (10 miles east) and Grand Canyon Village / Tusayan (32 miles west)."],nearbyAttractions:["Grand Canyon Desert View Watchtower","Cameron Trading Post","Wupatki National Monument","Sunset Crater Volcano"]},{id:"meteor-crater-natural-landmark",name:"Meteor Crater & Barringer Space Museum",designation:"National Natural Landmark",image:"https://kosher-travel-img.sites.tab.bot/wm/2822d719a7ce053a.webp",photoGallery:[],shortDescription:"The world’s best-preserved meteorite impact site on Earth, blasted 50,000 years ago by an asteroid traveling 26,000 mph.",fullDescription:"Meteor Crater (Barringer Crater) is the world’s best-preserved meteorite impact crater, located near Winslow, Arizona. Created approximately 50,000 years ago when a 150-foot nickel-iron meteorite struck the Colorado Plateau with the explosive force of 20 million tons of TNT, the crater measures nearly 1 mile across (3,900 feet) and 560 feet deep. The site served as official training grounds for Apollo astronauts preparing for lunar landings and features an interactive science discovery center.",thingsToDo:["Stand on the Rim Observation Decks Overlooking the 1-Mile Wide Crater","Join the Expert Guided Rim Walking Tour with Staff Geologists",'Experience the Interactive 4D "Collision!" Theater Ride',"Touch Genuine Iron-Nickel Meteorite Fragments in the Discovery Center","Explore the Apollo Astronaut Training Test Capsule and Memorial"],hikingTrails:[{name:"Guided Rim Trail Walk",difficulty:"Easy",length:"0.6 miles RT",description:"A staff-guided walking tour along the paved upper rim path explaining the impact physics, geology, and Apollo training history."}],scenicDrives:[{name:"Meteor Crater Road Scenic Approach",length:"6.0 miles",description:"Paved spur road heading south from I-40 (Exit 233) climbing through high desert plains directly to the crater rim."}],visitorCenter:{name:"Meteor Crater Discovery Center & Space Museum",info:"State-of-the-art interactive science center, 4D immersive theater, Apollo exhibit hall, gift shop, and Blimpies restaurant.",phone:"(928) 289-5898",hours:"Daily: 8:00 AM – 5:00 PM (Summer: 7:00 AM – 7:00 PM)"},campingInfo:"Meteor Crater RV Park is located at the I-40 interchange (Exit 233) featuring full hookups, Wi-Fi, private showers, and recreation room.",wildlife:["Pronghorn Antelope","Ravens","Desert Cottontails","Gopher Snakes"],bestViewpoints:["Upper Telescope Viewing Terrace","Lower Indoor Observation Room","Apollo Test Capsule Platform"],entranceFees:"$27.00 Adults (13–59), $18.00 Juniors (6–12), $25.00 Seniors (60+). Private National Natural Landmark (NPS passes not valid).",hours:"Open daily 8:00 AM to 5:00 PM (extended summer hours 7:00 AM to 7:00 PM). Closed Christmas Day.",address:"Interstate 40 Exit 233, Winslow, AZ 86047",googleMapsLocation:"https://maps.google.com/?q=Meteor+Crater+Visitor+Center+35.0275,-111.0228",officialWebsite:"https://meteorcrater.com/",bestTimeToVisit:"Year-round; early morning or late afternoon visits provide dramatic shadow relief across the crater floor and cooler temperatures.",accessibilityInfo:"The Discovery Center, theaters, indoor observation deck, and main outdoor telescope platform are fully ADA accessible.",travelTips:["High Elevation & Wind: The crater rim sits at 5,700 feet elevation and experiences intense winds; hold tight to loose items.","Guided Tour Included: The 45-minute guided rim tour is included free with general admission and departs every hour (weather permitting).","Interior Hiking Restricted: Hiking down to the crater floor is strictly prohibited to preserve the fragile impact geology.","Gateway Towns: Winslow, AZ is 18 miles east; Flagstaff, AZ is 35 miles west along I-40 with full lodging and dining."],nearbyAttractions:["Standin' on the Corner Park (Winslow)","Petrified Forest National Park","Homolovi State Park","Walnut Canyon National Monument"]}],utah:[{id:"monument-valley-navajo-tribal-park-ut",name:"Monument Valley Navajo Tribal Park",designation:"Tribal Park",image:"https://kosher-travel-img.sites.tab.bot/wm/33224476f4812d10.webp",photoGallery:[],shortDescription:"World-famous red sandstone buttes and sacred Navajo landscapes immortalized in classic cinema.",fullDescription:"Monument Valley Navajo Tribal Park straddles the Arizona-Utah border on the sacred ancestral lands of the Navajo Nation (Diné). Towering sandstone monoliths, buttes, and spires rise between 400 and 1,000 feet above the vibrant desert floor. Visitors can drive the legendary 17-mile unpaved Valley Drive or hire licensed Navajo guides to access sacred backcountry areas like Mystery Valley, Hunts Mesa, and Ear of the Wind.",thingsToDo:["Drive the 17-Mile Scenic Dirt Loop","Take a Certified Navajo Guided 4x4 Tour","Hike the Wildcat Trail around West Mitten Butte","Photograph Sunset and Sunrise at the View Hotel Overlook","Visit Navajo Hogan Demonstrations and Artisan Stands"],hikingTrails:[{name:"Wildcat Trail",difficulty:"Moderate",length:"3.2 miles loop",description:"The only self-guided hiking trail in the park, circling around the iconic West Mitten Butte with spectacular ground-level views of the Mittens and Merrick Butte."}],scenicDrives:[{name:"17-Mile Valley Drive",length:"17.0 miles",description:"A graded dirt road passing the East and West Mitten Buttes, Merrick Butte, Three Sisters, John Ford Point, Totem Pole, and Artist Point."},{name:"US-163 Scenic Byway (Forrest Gump Point)",length:"13.0 miles",description:"The iconic highway straightaway with panoramic head-on views of Monument Valley buttes made famous in the film Forrest Gump."}],visitorCenter:{name:"Monument Valley Visitor Center",info:"Features an observation deck, Navajo cultural exhibits, restaurant, and gift shop with authentic Navajo silversmithing and rugs.",phone:"(435) 727-5870",hours:"Peak Season: 6:00 AM – 8:00 PM; Off-Peak: 8:00 AM – 5:00 PM"},campingInfo:"The View Campground offers primitive wilderness campsites and RV sites overlooking the valley. Gouldings Resort & Campground (5 miles west) provides full hookups, cabins, and indoor pool.",wildlife:["Desert Bighorn Sheep","Coyotes","Golden Eagles","Ravens"],bestViewpoints:["Forrest Gump Hill (Mile Marker 13 on US-163)","John Ford Point","Artist Point"],entranceFees:"$8.00 per person entry fee. (NPS passes are not accepted on sovereign tribal land).",hours:"Open 7 days a week year-round.",address:"Indn Route 42, Oljato-Monument Valley, UT 84536",googleMapsLocation:"https://maps.google.com/?q=Monument+Valley+Navajo+Tribal+Park+36.9830,-110.1115",officialWebsite:"https://navajonationparks.org/tribal-parks/monument-valley/",bestTimeToVisit:"Spring and Autumn for mild temperatures and striking desert lighting.",accessibilityInfo:"Visitor Center and observation deck are ADA accessible.",travelTips:["Sovereign Tribal Land: Alcohol is strictly prohibited across the Navajo Nation.","High Clearance Recommended: Valley Drive is rough washboard dirt with deep ruts.","Nearest Staging Towns: Mexican Hat / Bluff, UT (22–45 miles north) and Kayenta, AZ (23 miles south)."],nearbyAttractions:["Goosenecks State Park","Valley of the Gods","Moki Dugway","Bears Ears National Monument"]},{id:"valley-of-the-gods-blm",name:"Valley of the Gods",designation:"BLM Scenic Area",image:"https://kosher-travel-img.sites.tab.bot/wm/b42718a1c69b6bba.webp",photoGallery:[],shortDescription:"A dramatic, peaceful red-sandstone wilderness of solitary buttes, towers, and pinnacles known as a mini-Monument Valley.",fullDescription:"Valley of the Gods is a breathtaking 17-mile scenic drive winding through solitary Cedar Mesa sandstone buttes, pinnacles, and towers in southeastern Utah. Managed by the Bureau of Land Management, this uncrowded red-rock basin offers the dramatic geological drama of Monument Valley with complete solitude, zero admission fees, and pristine free dispersed wilderness camping.",thingsToDo:["Drive the 17-Mile Scenic Dirt Loop through Sandstone Monoliths","Camp under Pristine Dark Skies among Towering Red Buttes","Photograph Sunrise and Sunset on Rooster Butte and Castle Rock","Scramble around Balanced Rocks and Natural Sandstone Pillars","Combine with Moki Dugway and Muley Point Overlooks"],hikingTrails:[{name:"Valley of the Gods Open Wilderness Wandering",difficulty:"Easy to Moderate",length:"Flexible cross-country",description:"No established trails; visitors can wander off-road around the bases of named monoliths like Setting Hen Butte and Battleship Rock."}],scenicDrives:[{name:"Valley of the Gods 17-Mile Scenic Backway",length:"17.0 miles",description:"Graded dirt road connecting US-163 (near Mexican Hat) to UT-261 (at the base of the Moki Dugway switchbacks)."}],visitorCenter:{name:"BLM Monticello Field Office",info:"Provides maps, road condition updates, and dispersed camping regulations for San Juan County public lands.",phone:"(435) 587-1500",hours:"Monday – Friday: 8:00 AM – 4:30 PM"},campingInfo:"Free dispersed BLM camping permitted throughout the entire valley in existing pullouts. Strict Leave No Trace rules apply; pack out all trash and waste.",wildlife:["Mule Deer","Desert Bighorn Sheep","Coyotes","Golden Eagles","Collared Lizards"],bestViewpoints:["Castle Butte Vista","Setting Hen Butte","Battleship Rock","Muley Point (1,200 ft directly above on Cedar Mesa)"],entranceFees:"Free (no entrance fees or permits required).",hours:"Open 24 hours daily year-round.",address:"UT-261 / US-163, Mexican Hat, UT 84531",googleMapsLocation:"https://maps.google.com/?q=Valley+of+the+Gods+Utah+37.2344,-109.8142",officialWebsite:"https://www.blm.gov/visit/valley-gods",bestTimeToVisit:"Spring (March–May) and Autumn (September–November) for ideal desert driving and camping weather.",accessibilityInfo:"Scenic loop is an unpaved gravel/dirt road; accessible by standard vehicles during dry conditions but washboarded.",travelTips:["Road Conditions: The 17-mile road is typically passable for standard cars when dry, but impassable during and after rain due to muddy wash crossings.","Zero Facilities: No water, no restrooms, and no trash cans in the valley.","Moki Dugway Connection: The west exit connects directly to UT-261 leading up the legendary 1,200-foot unpaved switchbacks of Moki Dugway to Muley Point.","Nearby Towns: Mexican Hat (5 miles) and Bluff (15 miles) offer gas, dining, and lodging."],nearbyAttractions:["Goosenecks State Park","Moki Dugway & Muley Point","Monument Valley","Bears Ears National Monument"]},{id:"grand-staircase-escalante-national-monument",name:"Grand Staircase-Escalante National Monument",designation:"BLM National Monument",image:"https://kosher-travel-img.sites.tab.bot/wm/237e1c4825aab179.webp",photoGallery:[],shortDescription:"A vast, rugged 1.87-million-acre wilderness of labyrinth slot canyons, towering monoliths, and ancient fossil beds.",fullDescription:"Grand Staircase-Escalante National Monument spans nearly 1.87 million acres of pristine canyon wilderness in southern Utah. Spanning three distinct physiographic regions—the Grand Staircase cliffs, the Kaiparowits Plateau, and the Escalante River Canyons—it preserves world-famous slot canyons like Peek-a-boo and Spooky Gulch, majestic waterfalls like Lower Calf Creek Falls, and premier dinosaur fossil deposits.",thingsToDo:["Squeeze Through the Narrow Passages of Peek-a-boo and Spooky Slot Canyons","Hike to the 126-Foot Lower Calf Creek Falls and Emerald Plunge Pool","Drive the Spectacular Unpaved Burr Trail Road and Switchbacks","Explore the Otherworldly Hoodoos of Devils Garden off Hole-in-the-Rock Road","Backpack the Pristine Wild Narrows of the Escalante River"],hikingTrails:[{name:"Lower Calf Creek Falls Trail",difficulty:"Moderate",length:"6.0 miles RT",description:"A sandy trail through a lush canyon corridor passing beaver ponds and prehistoric Fremont rock art panels to a 126-foot cascading waterfall."},{name:"Peek-a-boo and Spooky Slot Canyons Loop",difficulty:"Strenuous",length:"3.5 miles loop",description:"Thrilling technical slot canyons requiring climbing a 12-foot dryfall into Peek-a-boo and squeezing through 10-inch tight narrows in Spooky Gulch."}],scenicDrives:[{name:"Utah Scenic Byway 12 (All-American Road)",length:"122.0 miles",description:"One of the most spectacular scenic highways in America, crossing the Hogback ridge and cutting through the heart of Grand Staircase."},{name:"Burr Trail Scenic Backway",length:"67.0 miles",description:"Scenic backcountry drive from Boulder through Long Canyon and Capitol Reef Waterpocket Fold switchbacks."}],visitorCenter:{name:"Escalante Interagency Visitor Center",info:"Provides trail conditions, weather forecasts, free backcountry camping permits, and interpretive exhibits on canyon geology.",phone:"(435) 826-5499",hours:"Daily: 8:00 AM – 4:30 PM (March – November)"},campingInfo:"Developed campgrounds at Calf Creek Campground (13 sites). Free dispersed wilderness camping is permitted across BLM lands with a free self-issued permit.",wildlife:["Desert Bighorn Sheep","Mountain Lions","Peregrine Falcons","Spotted Bats","Southwestern Willow Flycatchers"],bestViewpoints:["The Hogback on Scenic Byway 12","Boynton Overlook","Head of the Rocks Overlook","Grosvenor Arch"],entranceFees:"Free general admission. Calf Creek Recreation Area day-use fee is $5.00/vehicle (or NPS America the Beautiful pass).",hours:"Open 24 hours daily year-round.",address:"755 W Main St, Escalante, UT 84726",googleMapsLocation:"https://maps.google.com/?q=Grand+Staircase-Escalante+National+Monument+37.5255,-111.6022",officialWebsite:"https://www.blm.gov/programs/national-conservation-lands/utah/grand-staircase-escalante-national-monument",bestTimeToVisit:"Spring (April–May) and Autumn (September–October). Summer flash flood risk is high during July–August monsoons.",accessibilityInfo:"Escalante Visitor Center is fully accessible. Calf Creek trail is deep sand; slot canyons are extremely narrow and rugged.",travelTips:["Hole-in-the-Rock Road Driving: Unpaved, severe washboard dirt; dry conditions required. Rain makes the clay impassable even for 4WD.","Spooky Slot Tightness: Spooky Gulch narrows to under 10 inches wide in sections; remove backpacks and do not attempt if claustrophobic.","Zero Cell Service: Over 90% of the monument has zero cellular reception.","Gateway Towns: Escalante, Boulder, and Kanab provide lodging, outfitters, fuel, and groceries."],nearbyAttractions:["Bryce Canyon National Park","Capitol Reef National Park","Kodachrome Basin State Park","Anasazi State Park Museum"]},{id:"bears-ears-national-monument",name:"Bears Ears National Monument",designation:"BLM National Monument",image:"https://kosher-travel-img.sites.tab.bot/wm/0efadb16a9e0ad7b.webp",photoGallery:[],shortDescription:"A sacred 1.36-million-acre ancestral landscape of sandstone canyons, twin mesa buttes, and thousands of ancient cliff dwellings.",fullDescription:"Bears Ears National Monument encompasses 1.36 million acres of protected canyonlands in San Juan County, Utah. Named for the iconic pair of winged sandstone buttes rising over Cedar Mesa, this sacred homeland is co-managed between the federal government (BLM & USFS) and the Bears Ears Inter-Tribal Coalition (representing the Navajo Nation, Hopi Tribe, Ute Mountain Ute Tribe, Pueblo of Zuni, and Ute Indian Tribe). The region protects more than 100,000 cultural and archaeological sites, including House on Fire, Moon House Ruin, and Grand Gulch.",thingsToDo:["Hike to the Glowing Ceiling of House on Fire in Mule Canyon","Photograph the Sacred Twin Bears Ears Buttes from Elk Ridge","Explore the Ancient Ancestral Puebloan Moon House Ruin (Permit Required)","Drive the Daring 1,200-Foot Cliffs of Moki Dugway to Muley Point",'Visit the Bears Ears Education Center in Bluff to Learn "Visit with Respect" Ethics'],hikingTrails:[{name:"House on Fire (Mule Canyon)",difficulty:"Easy",length:"1.9 miles RT",description:"A level walk up South Mule Canyon to a stunning 700-year-old cliff granary where morning sunlight makes the overhead rock look like licking flames."},{name:"Moon House Ruin Trail (McLoyd Canyon)",difficulty:"Moderate",length:"3.0 miles RT",description:"Descent into McLoyd Canyon to an exceptionally preserved Ancestral Puebloan defensive complex with rare interior paintings (BLM permit required)."}],scenicDrives:[{name:"UT-95 Trail of the Ancients Scenic Byway",length:"65.0 miles",description:"Paved scenic highway passing Comb Ridge, Mule Canyon, Natural Bridges, and the northern Bears Ears landscape."},{name:"UT-261 & Moki Dugway",length:"34.0 miles",description:"Climbs 1,200 vertical feet up Cedar Mesa on unpaved gravel switchbacks with dramatic vistas of Valley of the Gods and Monument Valley."}],visitorCenter:{name:"Bears Ears Education Center / BLM Monticello Office",info:"Non-profit grassroots visitor center in Bluff providing cultural etiquette guides, maps, and Leave No Trace education.",phone:"(435) 587-1500",hours:"Daily: 9:00 AM – 5:00 PM (seasonal)"},campingInfo:"Primitive dispersed camping is permitted on BLM and USFS land outside archaeological sites. Developed camping available at Natural Bridges and Comb Wash.",wildlife:["Desert Bighorn Sheep","Black Bears (Elk Ridge)","Mule Deer","Peregrine Falcons","Mountain Lions"],bestViewpoints:["Muley Point Overlook","Elk Ridge Bears Ears Buttes Vista","Comb Ridge Cuesta Cut","Salvation Knoll"],entranceFees:"Free general admission. Cedar Mesa day-use hiking permits ($5.00/person) and Moon House permits required for specific canyons.",hours:"Open 24 hours daily year-round.",address:"UT-95 & UT-261, Blanding, UT 84511",googleMapsLocation:"https://maps.google.com/?q=Bears+Ears+National+Monument+37.6080,-109.8667",officialWebsite:"https://www.blm.gov/programs/national-conservation-lands/utah/bears-ears-national-monument",bestTimeToVisit:"Spring (April to May) and Autumn (September to October). High summer brings dangerous heat; winter brings snow to Elk Ridge.",accessibilityInfo:"Bears Ears Education Center in Bluff is ADA accessible. Backcountry ruins and trails are remote, sandy, and rugged.",travelTips:["Visit with Respect Guidelines: Never touch, lean on, or climb into ancient ruin walls. Never touch rock art panels or pick up pottery sherds.","Leave Archaeological Sites Undisturbed: All artifacts and ruins are strictly protected under federal and tribal law.","High Clearance 4WD: Roads to Moon House and Elk Ridge are rough dirt and require high-clearance 4WD vehicles.","Gateway Staging Towns: Blanding, Monticello, and Bluff provide fuel, lodging, groceries, and outfitters."],nearbyAttractions:["Natural Bridges National Monument","Valley of the Gods","Edge of the Cedars State Park Museum","Goosenecks State Park"]},{id:"bonneville-salt-flats-blm",name:"Bonneville Salt Flats",designation:"BLM Special Recreation Management Area",image:"https://kosher-travel-img.sites.tab.bot/wm/efe1c758bfcb91c1.webp",photoGallery:[],shortDescription:"A 30,000-acre expanse of blindingly white, table-flat salt crust famous worldwide for land speed record racing.",fullDescription:"The Bonneville Salt Flats is a 30,000-acre geologic remnant of the ancient Pleistocene Lake Bonneville, located in northwestern Utah near the Nevada border. Composed of pure potassium and sodium chloride crystals, the flats are so intensely level that the curvature of the Earth is visibly noticeable. Famous worldwide as the stage for legendary land speed record runs at the Bonneville Speedway, the flats transform into a massive liquid mirror during winter and spring rains reflecting endless sky.",thingsToDo:["Walk onto the Blinding White Table-Flat Salt Crust","Photograph Incredible Sky Mirror Reflections after Winter and Spring Rains","Visit the Legendary Bonneville Speedway Starting Line","Watch High-Speed Racing Runs during Speed Week (August)","Capture Perspective-Bending Illusion Photography across the Horizon"],hikingTrails:[{name:"Salt Flats Open Surface Walk",difficulty:"Easy",length:"Open exploration",description:"Visitors walk directly out onto the firm, hard-packed salt crust from the end of the paved access road or I-80 Rest Area."}],scenicDrives:[{name:"Bonneville Speedway Access Road",length:"4.5 miles",description:"Paved road branching north from I-80 (Exit 4) leading directly onto the salt surface at the Bonneville Speedway staging area."}],visitorCenter:{name:"BLM Salt Lake Field Office / I-80 Salt Flats Rest Area",info:"Provides interpretive displays, water wash-off stations, observation walkways, and safety guidelines for driving on the salt.",phone:"(801) 977-4300",hours:"Rest Area open 24 hours; BLM office Monday–Friday 8:00 AM – 4:30 PM"},campingInfo:"No camping allowed directly on the salt flats. Free dispersed BLM camping is permitted on surrounding public lands outside the salt crust (e.g. Silver Island Mountains).",wildlife:["Horned Larks","Ravens","Kit Foxes (perimeter mountains)","Black-tailed Jackrabbits"],bestViewpoints:["Bonneville Speedway Road Terminus","I-80 Westbound Salt Flats Rest Area View Deck","Silver Island Mountains Loop Overlook"],entranceFees:"Free (no entrance fees or day-use permits required for standard visits).",hours:"Open 24 hours daily year-round (subject to seasonal weather and flooding closures).",address:"Bonneville Speedway Rd, Wendover, UT 84083",googleMapsLocation:"https://maps.google.com/?q=Bonneville+Salt+Flats+Rest+Area+40.7410,-113.8640",officialWebsite:"https://www.blm.gov/visit/bonneville-salt-flats",bestTimeToVisit:"Summer and Autumn (July to October) for dry, driveable salt conditions and racing events; Winter/Spring for giant water mirror reflections.",accessibilityInfo:"The I-80 Rest Area features paved ADA observation decks, walkways, and restrooms overlooking the salt expanse.",travelTips:["Never Drive on Wet Salt: When standing water or moisture is present, the salt is soft mud underneath; vehicles sink to their axles and require $1,000+ specialized tow rescues.","Intense Sun Reflection: The white salt reflects nearly 100% of UV rays; polarized sunglasses, sunscreen, and lip balm are essential.","Vehicle Undercarriage Wash: Driving on salt deposits corrosive sodium; wash your car's undercarriage thoroughly at Wendover car washes immediately after visiting.","Gateway Town: Wendover, UT and West Wendover, NV are 10 miles west with hotels, casinos, gas, and 24-hour amenities."],nearbyAttractions:["Silver Island Mountains Backcountry Byway","Historic Wendover Airfield Museum","Enola Gay Hangar","Blue Lake Scuba Park"]}],"new-mexico":[{id:"taos-pueblo-world-heritage-site",name:"Taos Pueblo",designation:"Sovereign Pueblo Heritage Site",image:"https://kosher-travel-img.sites.tab.bot/wm/2810fd4c05b701d5.webp",photoGallery:[],shortDescription:"An ancient, multi-storied adobe pueblo continuously inhabited by the Tiwa-speaking people for over 1,000 years.",fullDescription:"Taos Pueblo is a UNESCO World Heritage Site and National Historic Landmark located at the base of the Sangre de Cristo Mountains in northern New Mexico. Belonging to the sovereign Taos Pueblo nation, its multi-storied adobe apartment complexes (Hlauuma and Hlaukwima) have been continuously inhabited for more than 1,000 years. Preserving ancient Tiwa traditions, no electricity or running water is permitted within the historic adobe village walls, through which the sacred Red Willow Creek flows.",thingsToDo:["Take an Informative Guided Walking Tour led by Taos Pueblo Tribal Members","Admire the Multi-Story Adobe Architecture of Hlauuma (North House) and Hlaukwima (South House)","Sample Fresh Pueblo Bread and Sweet Pastries Baked in Traditional Adobe Horno Ovens","Visit San Geronimo Chapel and the Historic Ruins of the Original 1619 Church","Shop Direct for Handcrafted Micaceous Pottery, Silver Jewelry, and Moccasins"],hikingTrails:[{name:"Historic Pueblo Village Walking Tour",difficulty:"Easy",length:"0.75 miles walking loop",description:"A level walk through the central village plaza, crossing footbridges over Red Willow Creek and passing artisan hornos and shops."}],scenicDrives:[{name:"Enchanted Circle Scenic Byway",length:"84.0 miles",description:"Spectacular mountain highway looping around Wheeler Peak, connecting Taos, Questa, Red River, and Angel Fire."}],visitorCenter:{name:"Taos Pueblo Tourism Office & Welcome Center",info:"Coordinates visitor tickets, registered photography permits, native guided tours, and cultural etiquette orientations.",phone:"(575) 758-1028",hours:"Thursday – Monday: 9:00 AM – 4:00 PM (Closed Tuesday & Wednesday; seasonal ceremonial closures)"},campingInfo:"No camping on sovereign Taos Pueblo tribal lands. Extensive campgrounds located nearby in Carson National Forest and Taos RV parks (3 miles away).",wildlife:["Mule Deer","Elk","Golden Eagles","Red-tailed Hawks","Black Bears (surrounding mountains)"],bestViewpoints:["North House Adobe Complex Vista","Red Willow Creek Footbridge"],entranceFees:"$25.00 Adults, $22.00 Seniors & Students, Free for children under 10. Photography fee for personal cameras is included with admission.",hours:"Open Thursday through Monday 9:00 AM – 4:00 PM. Closed Tuesdays and Wednesdays and during confidential tribal ceremonies.",address:"120 Veterans Hwy, Taos, NM 87571",googleMapsLocation:"https://maps.google.com/?q=Taos+Pueblo+36.4389,-105.5458",officialWebsite:"https://taospueblo.com/",bestTimeToVisit:"Spring through Autumn for comfortable mountain weather and daily guided tours; winter offers snow-capped adobe photography.",accessibilityInfo:"The main plaza and village roads are packed dirt and gravel; wheelchair accessible with assistance in dry conditions.",travelTips:["Strict Photography Protocol: Commercial filming and tripods are strictly prohibited without written tribal permission. Never photograph tribal members without asking first.","Respect Restricted Areas: Do not enter residential doors marked private, do not climb on adobe ladders, and do not enter the sacred kivas or cemetery.","Check for Religious Closures: Taos Pueblo closes periodically for sovereign spiritual ceremonies; always check taospueblo.com before traveling.","Gateway Town: The town of Taos is just 3 miles south, offering world-class art galleries, restaurants, and hotels."],nearbyAttractions:["Rio Grande Gorge Bridge","Millicent Rogers Museum","Taos Plaza","Carson National Forest"]},{id:"shiprock-peak-navajo-sacred-monument",name:"Shiprock Peak (Tsé Bitʼaʼí)",designation:"Navajo Sacred Landmark",image:"https://kosher-travel-img.sites.tab.bot/wm/9bd92772eae8ff31.webp",photoGallery:[],shortDescription:'A sacred volcanic monadnock rising 1,583 feet above the high desert floor, revered as the "Rock with Wings" in Navajo tradition.',fullDescription:'Shiprock (Diné: Tsé Bitʼaʼí - "rock with wings") is a towering volcanic neck rising 1,583 feet above the high desert plain of northwestern New Mexico on the Navajo Nation. Formed 27 million years ago, the peak is framed by prominent radiating volcanic dike walls that stretch for miles like dark stone spines across the desert. In Navajo tradition, the formation represents the great bird that carried the ancestral Diné from the north.',thingsToDo:["Photograph the Magnificent Volcanic Monolith from Indian Service Route 13","Witness the Long Radiating Volcanic Dike Walls Extending Across the Plain","Capture Dramatic Sunrise and Sunset Golden Hour Lighting on the Pinnacle","Experience the Peaceful High Desert Solitude of the Four Corners Region","Stargaze under Unpolluted Navajo Nation Dark Skies"],hikingTrails:[{name:"Dike Wall Observation Walk",difficulty:"Easy",length:"0.5 miles",description:"A brief roadside walk from the unpaved pullouts to examine the dark igneous volcanic dike walls extending toward the base of the peak."}],scenicDrives:[{name:"Indian Service Route 13 (Navajo 13)",length:"18.0 miles",description:"Paved and graded highway connecting US-491 to Red Rock, offering panoramic 360-degree views of Shiprock Peak."}],visitorCenter:{name:"Navajo Nation Parks & Recreation Department",info:"Manages tourism oversight and cultural protections across the Navajo Nation.",phone:"(928) 871-6647",hours:"Monday – Friday: 8:00 AM – 5:00 PM"},campingInfo:"No camping permitted at Shiprock Peak. Lodging and RV parks available in Shiprock, NM (12 miles) and Farmington, NM (40 miles).",wildlife:["Golden Eagles","Prairie Falcons","Coyotes","Black-tailed Jackrabbits","Pronghorn Antelope"],bestViewpoints:["Navajo Route 13 Roadside Pullout (Best Direct Perspective)","South Volcanic Dike Wall Viewpoint","US-491 Vista Point"],entranceFees:"Free roadside viewing. (Climbing is strictly prohibited under Navajo Nation law).",hours:"Open 24 hours for roadside viewing and photography from public rights-of-way.",address:"US-491 & Indian Service Route 13, Shiprock, NM 87420",googleMapsLocation:"https://maps.google.com/?q=Shiprock+Peak+New+Mexico+36.6872,-108.8364",officialWebsite:"https://navajonationparks.org/",bestTimeToVisit:"Spring and Autumn for clear, crisp desert air; early morning sunrise provides unmatched golden illumination on the eastern rock faces.",accessibilityInfo:"Best viewed directly from roadside paved and gravel pullouts along Indian Service Route 13.",travelTips:["Strict Climbing Ban: Climbing on Shiprock Peak or its volcanic dikes is strictly illegal under Navajo Nation law and heavily penalized.","Respect Sacred Ground: Shiprock is deeply sacred in Navajo cosmology; treat the land with quiet reverence and pack out all trash.","Unpaved Dirt Roads: Dirt tracks leading closer to the base can have deep sand and sharp rocks; stay on main gravel corridors.","Nearby Towns: Shiprock, NM is 12 miles northeast with gas and food; Farmington, NM is 40 miles east with full hotels and amenities."],nearbyAttractions:["Four Corners Monument","Bisti Badlands","Mesa Verde National Park","Salmon Ruins"]},{id:"bisti-de-na-zin-wilderness",name:"Bisti/De-Na-Zin Wilderness",designation:"BLM Wilderness",image:"https://kosher-travel-img.sites.tab.bot/wm/6218d0ccd7910f65.webp",photoGallery:[],shortDescription:'A surreal 45,000-acre badland maze of bizarre stone hoodoos, petrified wood logs, and otherworldly "alien egg" rock formations.',fullDescription:'The Bisti/De-Na-Zin Wilderness is a vast 45,000-acre badland expanse in the San Juan Basin of northwestern New Mexico. Preserved in near-lunar isolation, this ancient Cretaceous river delta has eroded into one of the most surreal landscapes on Earth. Visitors wander through a dreamscape of mushroom-capped hoodoos, petrified wood trunks up to 30 feet long, coal seams, and the famous "Alien Throne" and "Cracked Eggs" rock clusters.',thingsToDo:['Hunt for the Famous "Alien Throne" and "Cracked Eggs" (Egg Garden) Hoodoos',"Discover Massive 70-Million-Year-Old Petrified Tree Trunks","Navigate the Untracked Labyrinth of Colored Siltstone and Shale Badlands","Stargaze under Pristine Dark Skies among Ghostly Stone Pillars","Photograph Dramatic Sunrise and Sunset Shadows across the Stone Forest"],hikingTrails:[{name:"Bisti Main Wash Exploration",difficulty:"Moderate",length:"4.0 to 6.0 miles RT (Cross-Country Route)",description:"Untracked wilderness route navigating east up the broad sandy wash into the North and South hoodoo labyrinths (GPS navigation required)."}],scenicDrives:[{name:"NM-371 Badlands Highway",length:"40.0 miles",description:"Paved highway connecting Farmington to Crownpoint, passing the access turnoff for County Road 7297."}],visitorCenter:{name:"BLM Farmington Field Office",info:"Provides topographic maps, GPS coordinate guides, weather warnings, and wilderness regulations.",phone:"(505) 564-7600",hours:"Monday – Friday: 8:00 AM – 4:30 PM"},campingInfo:"Free dispersed wilderness camping permitted throughout the BLM wilderness. No campfires allowed; pack out all trash and waste.",wildlife:["Coyotes","Prairie Falcons","Ferruginous Hawks","Badgers","Horned Lizards"],bestViewpoints:["The Egg Garden (Cracked Eggs)","The Alien Throne Hoodoo","The Stone Wings Formation","Petrified Forest Wash"],entranceFees:"Free (no entrance fees or day-use permits required).",hours:"Open 24 hours daily year-round.",address:"County Road 7297, Farmington, NM 87401",googleMapsLocation:"https://maps.google.com/?q=Bisti+Badlands+Trailhead+36.2592,-108.2514",officialWebsite:"https://www.blm.gov/visit/bisti-de-na-zin-wilderness",bestTimeToVisit:"Spring (March–May) and Autumn (September–November). Summer temperatures exceed 100°F with zero shade; winter brings freezing winds.",accessibilityInfo:"Strictly untamed wilderness terrain with deep sand, wash crossings, and badland mounds; not wheelchair accessible.",travelTips:["Mandatory GPS Navigation: There are NO marked trails or signs in the badlands. All hoodoos look identical on the return hike; carry a GPS device or offline phone maps.","Bentonite Clay Warning: During or after rain, the badland clay turns into sticky, impassable mud that coats boots and traps vehicles.","Carry Ample Water: Carry at least 1 gallon (4 liters) of water per person; there is zero water anywhere in the wilderness.","Staging Town: Farmington, NM is 36 miles north with hotels, outdoor gear shops, gas, and restaurants."],nearbyAttractions:["Ah-Shi-Sle-Pah Wilderness Study Area","Chaco Culture National Historical Park","Shiprock Peak","Aztec Ruins National Monument"]},{id:"ah-shi-sle-pah-wilderness-study-area",name:"Ah-Shi-Sle-Pah Wilderness Study Area",designation:"BLM Wilderness Study Area",image:"https://kosher-travel-img.sites.tab.bot/wm/149031c64ccfc162.webp",photoGallery:[],shortDescription:"An eerie, multi-colored badland basin filled with mushroom-shaped hoodoos, yellow sandstone spires, and rich dinosaur fossil beds.",fullDescription:"Ah-Shi-Sle-Pah Wilderness Study Area is a 6,563-acre badland wonderland located in the San Juan Basin of northwestern New Mexico. Carved into the Cretaceous Fruitland and Kirtland formations, this secluded valley features bizarre yellowish-green sandstone hoodoos, capped pillars, petrified tree stumps, and abundant fossilized dinosaur bones. Far less visited than nearby Bisti, Ah-Shi-Sle-Pah provides an extraordinary wilderness adventure.",thingsToDo:["Wander Among Strange Multi-Colored Hoodoos and Balanced Mushroom Rocks","Discover Cretaceous Fossil Beds, Dinosaur Bone Fragments, and Turtle Shells","Photograph Glowing Yellow and Orange Siltstone Spired Amphitheaters","Hike the Quiet Wash Corridors with Complete Backcountry Solitude","Experience World-Class Night Sky Astrophotography among Stone Sculptures"],hikingTrails:[{name:"Ah-Shi-Sle-Pah Wash Cross-Country Loop",difficulty:"Moderate",length:"3.0 to 5.0 miles RT",description:"An open cross-country exploration navigating from the rim down into the main badland wash and exploring side hoodoo canyons."}],scenicDrives:[{name:"San Juan County Road 7870",length:"18.0 miles",description:"Unpaved dirt and gravel backcountry road branching west from US-550 toward the wilderness study area boundary."}],visitorCenter:{name:"BLM Farmington Field Office",info:"Provides maps, road condition reports, and paleontological resource protection information.",phone:"(505) 564-7600",hours:"Monday – Friday: 8:00 AM – 4:30 PM"},campingInfo:"Free dispersed wilderness camping is permitted. Camp on durable surfaces; do not camp directly beneath fragile hoodoos or on fossil deposits.",wildlife:["Coyotes","Golden Eagles","Prairie Rattlesnakes","Kangaroo Rats","Horned Lizards"],bestViewpoints:["The Yellow Hoodoo Amphitheater","The Mushroom Cap Garden","The Petrified Forest Basin"],entranceFees:"Free (no fees or permits required).",hours:"Open 24 hours daily year-round.",address:"County Road 7870, Bloomfield, NM 87413",googleMapsLocation:"https://maps.google.com/?q=Ah-Shi-Sle-Pah+Wilderness+Trailhead+36.1554,-107.9192",officialWebsite:"https://www.blm.gov/programs/national-conservation-lands/new-mexico/ah-shi-sle-pah-wsa",bestTimeToVisit:"Spring and Autumn for mild temperatures and dry road access.",accessibilityInfo:"Rugged wilderness badland terrain with no developed paths; not wheelchair accessible.",travelTips:["Fossil Protection: All fossils, petrified wood, and cultural artifacts are strictly protected by federal law; collecting or disturbing them is illegal.","Unpaved Road Warning: County Road 7870 is unpaved dirt that becomes slick clay when wet; high-clearance 4WD recommended.","Offline Maps Essential: No cellular service; download offline maps and GPS tracks before leaving paved highways.","Gateway Towns: Bloomfield (45 miles) and Farmington (55 miles) provide fuel, hotels, and supplies."],nearbyAttractions:["Bisti/De-Na-Zin Wilderness","Chaco Culture National Historical Park","Angel Peak Scenic Area"]},{id:"kasha-katuwe-tent-rocks-national-monument",name:"Kasha-Katuwe Tent Rocks National Monument",designation:"BLM National Monument",image:"https://kosher-travel-img.sites.tab.bot/wm/048b32a57a2d23b2.webp",photoGallery:[],shortDescription:"Towering cone-shaped volcanic tent rocks and a dramatic slot canyon carved on the sacred ancestral lands of Pueblo de Cochiti.",fullDescription:"Kasha-Katuwe Tent Rocks National Monument is a remarkable geological landscape located on the Pajarito Plateau of north-central New Mexico. Formed by violent pyroclastic volcanic explosions from the Jemez Volcanic Field 6 to 7 million years ago, the monument features towering cone-shaped tent rock hoodoos up to 90 feet tall capped by resilient boulders. Co-managed between the Bureau of Land Management and the sovereign Pueblo de Cochiti, visitors hike through a soaring slot canyon to a high mesa overlook.",thingsToDo:["Hike the Spectacular Slot Canyon Trail through Sheer Volcanic Walls","Climb to the Mesa Top Overlook for 360-Degree Views of the Jemez Mountains","Walk the Level Cave Loop Trail to View Prehistoric Cavate Dwellings","Photograph the Cone-Shaped Volcanic Tent Rock Formations and Banded Pumice","Observe Native Birds along the Riparian Cottonwood Groves"],hikingTrails:[{name:"Canyon Trail (Slot Canyon to Mesa Top)",difficulty:"Moderate to Strenuous",length:"3.0 miles RT",description:"Narrows into a dramatic slot canyon before ascending 630 vertical feet through switchbacks to a panoramic mesa overlook."},{name:"Cave Loop Trail",difficulty:"Easy",length:"1.2 miles loop",description:"A gentle, level gravel loop past the bases of tent rocks and a historic cliff cave used by ancestral Puebloans."}],scenicDrives:[{name:"NM-22 / Cochiti Reservoir Scenic Route",length:"15.0 miles",description:"Scenic highway leading from I-25 through Cochiti Pueblo and along Cochiti Lake to the monument entrance."}],visitorCenter:{name:"Tent Rocks Contact Station / BLM Rio Puerco Office",info:"Provides interpretive brochures, trail safety orientation, weather advisories, and timed entry verification.",phone:"(505) 761-8700",hours:"Daily: 8:00 AM – 4:00 PM (seasonal schedule)"},campingInfo:"No camping inside the national monument. Developed camping and boat ramps available nearby at Cochiti Lake Recreation Area (Corps of Engineers, 6 miles).",wildlife:["Mule Deer","Coyotes","Red-tailed Hawks","Pinyon Jays","Mountain Lions"],bestViewpoints:["Mesa Top Overlook (Top of Canyon Trail)","The Tent Rock Amphitheater","Cave Loop Alcove"],entranceFees:"$5.00 per vehicle entry fee (or NPS America the Beautiful pass). Timed entry reservations may be required through Recreation.gov.",hours:"Open 8:00 AM to 4:00 PM (gates close to incoming entry at 3:00 PM). Check BLM status for current tribal access schedules.",address:"0 Indian Service Route 92, Cochiti Pueblo, NM 87072",googleMapsLocation:"https://maps.google.com/?q=Kasha-Katuwe+Tent+Rocks+National+Monument+35.6592,-106.4172",officialWebsite:"https://www.blm.gov/programs/national-conservation-lands/new-mexico/kasha-katuwe-tent-rocks-national-monument",bestTimeToVisit:"Spring and Autumn for pleasant hiking conditions; avoid midday summer heat due to steep, exposed slickrock climbs.",accessibilityInfo:"The first portion of the Cave Loop Trail is flat and accessible; the Slot Canyon Trail is narrow with rock scrambles.",travelTips:["Check Operational Status: Co-managed with Pueblo de Cochiti; check the official BLM website for current reopening schedules and reservation requirements.","No Pets Allowed: Domestic pets are strictly prohibited within the monument to protect native wildlife and sensitive cultural resources.","Early Arrival: The parking lot fills quickly on weekends; arrive when gates open at 8:00 AM.","Gateway Cities: Santa Fe (40 miles northeast) and Albuquerque (50 miles southwest) provide full amenities along I-25."],nearbyAttractions:["Cochiti Lake","Bandelier National Monument","Jemez Mountain Trail National Scenic Byway","Santa Fe Historic Plaza"]}],nevada:[{id:"red-rock-canyon-national-conservation-area",name:"Red Rock Canyon National Conservation Area",designation:"BLM National Conservation Area",image:"https://kosher-travel-img.sites.tab.bot/wm/60c3ba4c4b012b44.webp",photoGallery:[],shortDescription:"Towering red Aztec sandstone cliffs, ancient petroglyphs, and a 13-mile scenic drive just 17 miles from the Las Vegas Strip.",fullDescription:"Red Rock Canyon National Conservation Area protects 195,819 acres of vibrant Mojave Desert wilderness within the Spring Mountains, located just 17 miles west of the Las Vegas Strip. World-famous for its massive 3,000-foot Aztec Sandstone escarpment, Keystone Thrust Fault geologic marvel, ancient Native American roasting pits, and 13-mile one-way paved Scenic Loop Drive, it is an international destination for rock climbing, hiking, and wildlife viewing.",thingsToDo:["Drive the 13-Mile One-Way Paved Scenic Loop Drive","Hike to the Natural Sandstone Pools of Calico Tanks with Las Vegas Skyline Views","Scramble Across the Vibrant Red and Cream Dunes of Calico Hills","World-Class Sport and Traditional Rock Climbing on Aztec Sandstone Cliffs","Discover Ancient Native American Petroglyphs at Petroglyph Wall"],hikingTrails:[{name:"Calico Tanks Trail",difficulty:"Moderate",length:"2.5 miles RT",description:"Hikes up a sandstone canyon with moderate rock scrambling to a hidden natural water pool and stunning panoramic view of the Las Vegas Strip."},{name:"Ice Box Canyon Trail",difficulty:"Strenuous",length:"2.6 miles RT",description:"A rugged boulder-strewn hike up a shaded canyon where cold mountain air and seasonal waterfalls flow beneath massive cliff walls."},{name:"Keystone Thrust Trail",difficulty:"Moderate",length:"2.2 miles RT",description:"Leads to one of North America's most famous geologic fault lines where older grey limestone was thrust over younger red sandstone."}],scenicDrives:[{name:"Red Rock Scenic Loop Drive",length:"13.0 miles",description:"Paved, one-way scenic drive with multiple trailheads, scenic overlooks, and interpretive pullouts along the red rock escarpment."}],visitorCenter:{name:"Red Rock Canyon Visitor Center",info:"Award-winning LEED-Gold certified visitor center with interactive outdoor desert exhibits, live desert tortoises, bookstore, and weather reports.",phone:"(702) 515-5350",hours:"Daily: 8:00 AM – 4:30 PM"},campingInfo:"Red Rock Canyon Campground is located 2 miles east of the Scenic Loop on Moenkopi Road (72 individual sites, vault toilets, water faucets). Closed during summer heat.",wildlife:["Desert Bighorn Sheep","Desert Tortoises","Wild Burros","Coyotes","Chuckwallas","Golden Eagles"],bestViewpoints:["High Point Overlook (Highest Elevation on Scenic Drive)","Calico Hills Overlook","Red Rock Wash Overlook"],entranceFees:"$20.00 per car / vehicle entry fee (NPS America the Beautiful pass accepted). Timed Entry Reservation required Oct 1 – May 31 ($2.00 reservation fee via Recreation.gov).",hours:"Scenic Loop open daily: Nov–Feb: 6:00 AM – 5:00 PM; Mar & Oct: 6:00 AM – 7:00 PM; Apr–Sep: 6:00 AM – 8:00 PM.",address:"1000 Scenic Loop Dr, Las Vegas, NV 89161",googleMapsLocation:"https://maps.google.com/?q=Red+Rock+Canyon+Visitor+Center+36.1353,-115.4272",officialWebsite:"https://www.blm.gov/programs/national-conservation-lands/nevada/red-rock-canyon",bestTimeToVisit:"October through April for comfortable hiking temperatures; summer brings extreme 100°F+ heat.",accessibilityInfo:"Visitor Center exhibits, restrooms, and several paved overlook platforms along the Scenic Loop are fully ADA accessible.",travelTips:["Timed Entry System: Timed entry reservations are mandatory for driving the Scenic Loop between 8:00 AM and 5:00 PM from October 1 through May 31 (book on Recreation.gov).","Wet Sandstone Climbing Rule: Never climb on sandstone for at least 24–48 hours after rain; wet sandstone becomes brittle and breaks easily.","Proximity to Strip: Located only 25 minutes west of Las Vegas Boulevard; ride-shares (Uber/Lyft) can drop off at Visitor Center, but return cell service may be weak.","Carry Water: Always carry at least 2 liters of water per person even on short desert trails."],nearbyAttractions:["Spring Mountain Ranch State Park","Valley of Fire State Park","Mount Charleston","Las Vegas Strip"]}],idaho:[{id:"shoshone-falls-scenic-park",name:"Shoshone Falls Park",designation:"Scenic Natural Landmark",image:"https://kosher-travel-img.sites.tab.bot/wm/1526410e1fdf279c.webp",photoGallery:[],shortDescription:'The "Niagara of the West" – a thunderous 212-foot waterfall spanning 900 feet across the basalt Snake River Canyon.',fullDescription:'Shoshone Falls, famously heralded as the "Niagara of the West," is a majestic waterfall on the Snake River located near Twin Falls, Idaho. Plunging 212 feet over a rim nearly 900 feet wide—standing 36 feet higher than Niagara Falls—the waterfall roars into a rugged volcanic basalt canyon. Fed by melting snowpack from the Rocky Mountains, the falls reach their most thunderous power in the spring before seasonal agricultural diversion.',thingsToDo:["Stand on the Multi-Level Observation Decks Overlooking the Roaring Waterfall","Walk the Paved Snake River Canyon Rim Trail to Dierkes Lake","Swim and Paddleboard at the Shaded Beaches of Dierkes Lake Park",'Experience the Dazzling "Shoshone Falls After Dark" Light Show (May)',"Kayak the Snake River Canyon to Pillar Falls and the Base of Shoshone Falls"],hikingTrails:[{name:"Canyon Rim Trail (Shoshone Falls Section)",difficulty:"Easy",length:"2.0 miles one-way",description:"A paved, scenic multi-use path along the volcanic canyon rim offering continuous views of the Snake River and falls."},{name:"Dierkes Lake Walking Trail",difficulty:"Easy",length:"1.7 miles loop",description:"A scenic trail looping around the clear spring-fed waters of Dierkes Lake with swimming areas and hidden rock alcoves."}],scenicDrives:[{name:"Shoshone Falls Grade Scenic Road",length:"3.5 miles",description:"Descends the steep basalt canyon grade from Twin Falls city directly to the waterfall overlook plaza and riverbanks."}],visitorCenter:{name:"Shoshone Falls Information Kiosk & Park Office",info:"Staffed City of Twin Falls Parks & Recreation kiosk with trail maps, gift shop, restrooms, and flow rate monitors.",phone:"(208) 736-2265",hours:"Daily: 8:00 AM – 9:00 PM (seasonal)"},campingInfo:"No overnight camping in Shoshone Falls Park. RV and tent camping available nearby at Twin Falls 93 RV Park and Rock Creek Park (6 miles).",wildlife:["Marmots (Rockchucks)","River Otters","Pelicans","Ospreys","Golden Eagles","Rainbow Trout"],bestViewpoints:["Shoshone Falls Main Overlook Deck","Upper Picnic Area Vista","Dierkes Lake High Rim Overlook"],entranceFees:"$5.00 per vehicle entry fee (charged March 1 through September 30; free during fall/winter). City of Twin Falls municipal park (NPS passes not valid).",hours:"Open daily from dawn to dusk (gates open 7:00 AM to 10:00 PM in summer).",address:"4155 Shoshone Falls Grade, Twin Falls, ID 83301",googleMapsLocation:"https://maps.google.com/?q=Shoshone+Falls+Park+Twin+Falls+ID+42.5936,-114.4008",officialWebsite:"https://www.tfid.org/309/Shoshone-Falls",bestTimeToVisit:"Spring (April through June) when mountain snowmelt produces peak water volume (often exceeding 10,000–20,000 cfs).",accessibilityInfo:"The main parking lot, concession area, restrooms, and upper viewing platforms are fully ADA wheelchair accessible.",travelTips:["Peak Water Flow Timing: Check the live Snake River flow rate online before visiting; spring offers peak cascades, while late summer water is diverted for regional irrigation.","Shoshone Falls After Dark: In May, the falls are illuminated in dynamic multicolored LED lights with choreographed music.","Combine with Perrine Bridge: Visit the famous Perrine Memorial Bridge in Twin Falls (5 miles west) to watch year-round BASE jumpers leaping 486 feet into the canyon.","Gateway Town: Twin Falls is 5 miles away with complete dining, hotels, breweries, and gas stations."],nearbyAttractions:["Perrine Memorial Bridge & Canyon Rim Trail","Perrine Coulee Falls","Centennial Waterfront Park","Craters of the Moon National Monument"]}]},t=e=>{if(!e)return[];const a=e.toLowerCase().trim().replace(/[-_]/g," "),i=a.replace(/\s+/g,"-");return o[a]||o[i]||[]};export{o as TRIBAL_SCENIC_LANDMARKS_DATABASE,t as getTribalAndScenicParksForState};
