    <script>
      (function () {
        try {
          var h = document.documentElement;
          if (h.classList.contains('native-app') || h.classList.contains('kt-shell')) return;
          h.classList.add('kt-splashing');
          var q = new URLSearchParams(location.search);
          var link = (location.pathname === '/' || location.pathname === '/index.html') && (q.has('story') || q.has('map')) && q.get('review') !== 'reports';
          var done = false;
          window.__ktSplashLink = link;
          window.__ktSplashDone = function () {
            if (done) return; done = true;
            var el = document.getElementById('kt-splash');
            if (!el) { h.classList.remove('kt-splashing'); return; }
            el.style.opacity = '0';
            setTimeout(function () { h.classList.remove('kt-splashing'); if (el.parentNode) el.parentNode.removeChild(el); }, 200);
          };
          // never stuck: the app normally takes it down long before this
          setTimeout(window.__ktSplashDone, link ? 25000 : 15000);
        } catch (e) {}
      })();
    </script>

