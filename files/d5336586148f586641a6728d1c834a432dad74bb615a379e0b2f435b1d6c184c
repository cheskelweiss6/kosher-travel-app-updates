.kt-news-chips { padding: 6px 20px; margin: 0 -20px; scroll-padding-left: 20px; }
.kt-news-chips .kt-chip::after { top: -5px; bottom: -5px; }
.kt-news-item > button:focus-visible { outline: 2px solid #191e3b; outline-offset: 2px; }
.kt-news-icon:focus-visible { outline: 2px solid #191e3b; outline-offset: -4px; }
.kt-news-item > button:active .kt-news-title { color: #191e3b; opacity: .8; }
@media (min-width: 1024px) {
  .kt-news-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 28px; align-items: start; }
  .kt-news-grid-b { margin-top: 0; }
