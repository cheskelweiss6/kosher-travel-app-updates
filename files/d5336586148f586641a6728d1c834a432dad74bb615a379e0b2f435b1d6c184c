  .kt-news-grid-b > article:first-child > button { padding-top: 0; }
}
@media (hover: hover) and (pointer: fine) {
  .kt-news-item > button:hover .kt-news-title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .kt-news-item > button:hover img { filter: brightness(.96); }
