eing","Photography","Guided Walks","Wildlife Viewing","Historical Exhibits","Ranger Talks"],hikingTrails:[{name:"McDougal Trail",difficulty:"See nps.gov",length:"15-45 Minutes",description:"A 1/2mile-long dirt path winding through woods to reach McDougal Mound."},{name:"Bartram Trail",difficulty:"See nps.gov",length:"20-40 Minutes",description:"A 3/4th mile hike through woods between the Southeast Mound and the Visitor Center."},{name:"Hitchiti Village Site Trail",difficulty:"See nps.gov",length:"5-15 Minutes",description:"A 1/4th mile hike through woods connecting the Trading Post to the Funeral Mound."}],scenicDrives:[],visitorCenter:{name:"Ocmulgee Visitor Center",info:"The main visitor contact point, providing maps, informational brochures, and educational displays.",phone:"(478) 752-8257"},rangerPrograms:["Daily Ranger-led Educational Talks","Junior Ranger Activity Programs"],campingInfo:"NPS lists no camping at this site.",wildlife:["Deer","Red-tailed Hawks","Songbirds","Coyotes"],bestViewpoints:["Main Overlook","Visitor Center Observation Deck"],entranceFees:"Free (no entrance fee)",hours:`Ocmulgee Mounds National Historical Park   

