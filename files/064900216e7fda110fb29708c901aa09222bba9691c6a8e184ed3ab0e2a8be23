const o={alabama:[{id:"birmingham-civil-rights-national-monument",name:"Birmingham Civil Rights National Monument",image:"https://www.nps.gov/common/uploads/structured_data/D2364DA9-9311-7D39-478170FB4393F3C0.jpeg",photoGallery:[],shortDescription:"This monument preserves pivotal sites in Birmingham where the struggle for civil rights dramatically reshaped American society during the 1950s and 1960s. It stands as a testament to the courage of those who fought against segregation and injustice.",fullDescription:"Encompassing significant landmarks like the 16th Street Baptist Church, Kelly Ingram Park, and the A.G. Gaston Motel, Birmingham Civil Rights National Monument tells the powerful story of the Civil Rights Movement. These sites bore witness to nonviolent protests, violent oppression, and the eventual triumph of federal legislation protecting voting rights and desegregating public accommodations. The monument offers an immersive experience into a critical chapter of American history, honoring the sacrifices made for equality.",thingsToDo:["Sightseeing","Photography","Guided Walks","Wildlife Viewing","Historical Exhibits","Ranger Talks"],hikingTrails:[],scenicDrives:[],visitorCenter:{name:"Birmingham Visitor Center",info:"The main visitor contact point, providing maps, informational brochures, and educational displays.",phone:"(205) 679-0065"},rangerPrograms:["Daily Ranger-led Educational Talks","Junior Ranger Activity Programs"],campingInfo:"NPS lists no camping at this site.",wildlife:["Deer","Red-tailed Hawks","Songbirds","Coyotes"],bestViewpoints:["Main Overlook","Visitor Center Observation Deck"],entranceFees:"Free (no entrance fee)",hours:"Birmingham Civil Rights National Monument brochures and NPS passport stamp are available for visitors at the Birmingham Civil Rights Institute on Sunday's, 1:00 - 5:00 PM and Tuesday - Saturday, 10:00 AM - 5:00 PM. The A.G.",address:"Alabama, USA",googleMapsLocation:"https://maps.google.com/?q=Birmingham%20Civil%20Rights%20National%20Monument",officialWebsite:"https://www.nps.gov/bicr/index.htm",bestTimeToVisit:"Spring and Autumn (mild weather)",accessibilityInfo:"The visitor center and several designated viewing platforms/trails are fully wheelchair accessible.",travelTips:["Check the official NPS website before visiting for current weather and conditions.","Carry plenty of drinking water and pack out all trash."],nearbyAttractions:[],designation:"National Monument"},{id:"freedom-riders-national-monument",name:"Freedom Riders National Monument",image:"https://www.nps.gov/common/uploads/structured_data/89E23FDC-9BE7-D83A-83DEECF7210BD97D.jpg",photoGallery:[],shortDescription:"Commemorating the courageous 1961 Freedom Rides, this monument in Anniston marks the site where a Greyhound bus was firebombed by a white mob, highlighting the violent resistance to desegregation. It preserves the memory of those who risked their lives to challenge segregation in interstate travel.",fullDescription:"Freedom Riders National Monument preserves the former Greyhound bus station and the site where a Freedom Riders bus was attacked and burned on May 14, 1961, near Anniston, Alabama. This event, a brutal response to peaceful protest, galvanized the Civil Rights Movement and drew national attention to the injustices of segregation. The monument tells the story of the brave individuals who rode buses into the Deep South to challenge segregated interstate travel, ultimately contributing to the passage of federal civil rights legislation.",thingsToDo:["Sightseeing","Photography","Guided Walks","Wildlife Viewing","Historical Exhibits","Ranger Talks"],hikingTrails:[],scenicDrives:[],visitorCenter:{name:"Freedom Visitor Center",info:"The main visitor contact point, providing maps, informational brochures, and educational displays.",phone:"(205) 568-3963"},rangerPrograms:["Daily Ranger-led Educational Talks","Junior Ranger Activity Programs"],campingInfo:"NPS lists no camping at this site.",wildlife:["Deer","Red-tailed Hawks","Songbirds","Coyotes"],bestViewpoints:["Main Overlook","Visitor Center Observation Deck"],entranceFees:"Free (no entrance fee)",hours:"The historic Anniston Greyhound Bus Depot, located at 1031 Gurnee Avenue. This is the Greyhound Depot the Freedom Riders attempted to integrate on May 14, 1961.",address:"Alabama, USA",googleMapsLocation:"https://maps.google.com/?q=Freedom%20Riders%20National%20Monument",officialWebsite:"https://www.nps.gov/frri/index.htm",bestTimeToVisit:"Spring and Autumn (mild weather)",accessibilityInfo:"The visitor center and several designated viewing platforms/trails are fully wheelchair accessible.",travelTips:["Check the official NPS website before visiting for current weather and conditions.","Carry plenty of drinking water and pack out all trash."],nearbyAttractions:[],designation:"National Monument"},{id:"russell-cave-national-monument",name:"Russell Cave National Monument",image:"https://www.nps.gov/common/uploads/structured_data/3C8726D8-1DD8-B71B-0BD90F30D72A98BF.jpg",photoGallery:["https://www.nps.gov/common/uploads/structured_data/3C872BFB-1DD8-B71B-0B78CA89CD61BF25.jpg"],shortDescription:"Russell Cave preserves one of the most complete records of prehistoric cultures in the southeastern United States, showcasing continuous human habitation for over 9,000 years. This significant archaeological site offers a unique window into ancient lifeways and adaptions to changing environments.",fullDescription:"Russell Cave National Monument protects a large limestone cave that provided shelter for prehistoric peoples from approximately 10,000 B.C. to 1650 A.D. Archaeological excavations have revealed layers of artifacts, including tools, pottery, and animal bones, which tell the story of hunter-gatherers and later agriculturalists. The cave's strategic location and consistent shelter made it an ideal long-term habitation site, offering invaluable insights into early American history and indigenous cultures in the Southeast.",thingsToDo:["Sightseeing","Photography","Guided Walks","Wildlife Viewing"],hikingTrails:[{name:"Take a Hike on the Russell Cave Nature Trail",difficulty:"Strenuous",length:"30-60 Minutes",description:"Adventure up the strenuous 1.2-mile nature trail to see the plants and landscape that prehistoric people would have been interacting with while living at Russell Cave."}],scenicDrives:[],visitorCenter:{name:"Russell Visitor Center",info:"The main visitor contact point, providing maps, informational brochures, and educational displays.",phone:"(256) 495-2672"},rangerPrograms:["Daily Ranger-led Educational Talks","Junior Ranger Activity Programs"],campingInfo:"NPS lists no camping at this site.",wildlife:["Deer","Red-tailed Hawks","Songbirds","Coyotes"],bestViewpoints:["Main Overlook","Visitor Center Observation Deck"],entranceFees:"Free (no entrance fee)",hours:"The park is closed on New Year's Day, Thanksgiving, and Christmas. All operating hours are in central time and the main gate into the park closes at 4:30 pm.",address:"Alabama, USA",googleMapsLocation:"https://maps.google.com/?q=Russell%20Cave%20National%20Monument",officialWebsite:"https://www.nps.gov/ruca/index.htm",bestTimeToVisit:"Spring and Autumn (mild weather)",accessibilityInfo:"The visitor center and several designated viewing platforms/trails are fully wheelchair accessible.",travelTips:["Check the official NPS website before visiting for current weather and conditions.","Carry plenty of drinking water and pack out all trash."],nearbyAttractions:[],designation:"National Monument"},{id:"little-river-canyon-national-preserve",name:"Little River Canyon National Preserve",image:"https://www.nps.gov/common/uploads/structured_data/3C870F95-1DD8-B71B-0B1A89976F5B3292.jpg",photoGallery:["https://www.nps.gov/common/uploads/structured_data/8C825EA4-0C4E-1B2F-69AC99C5CBFF3679.jpg","https://www.nps.gov/common/uploads/structured_data/3C871272-1DD8-B71B-0BAB8ECC34CDFAB1.jpg","https://www.nps.gov/common/uploads/structured_data/3C8715EF-1DD8-B71B-0BB9222FFF98A466.jpg","https://www.nps.gov/common/uploads/structured_data/8C37F45E-E19E-9A6A-1B42A53A022BBA37.jpg"],shortDescription:"Little River Canyon National Preserve protects one of the deepest and most extensive canyon systems east of the Mississippi River, renowned for its dramatic waterfalls, sheer cliffs, and unique biodiversity. The Little River is exceptional as it flows almost entirely atop a mountain, descending into its self-carved canyon.",fullDescription:"Carved by the Little River atop Lookout Mountain, this preserve offers breathtaking vistas, plunging waterfalls like Grace's High Falls and Little River Falls, and an abundance of wildlife. The canyon rim provides scenic drives and overlooks, while the canyon floor offers opportunities for hiking, kayaking, and fishing. Its diverse ecosystems, from high-elevation forests to riverine habitats, support a wide array of plant and animal species, making it a significant natural and recreational resource in northeastern Alabama.",thingsToDo:["Sightseeing","Photography","Guided Walks","Wildlife Viewing","Hiking","Nature Trails","Kayaking","Swimming"],hikingTrails:[],scenicDrives:[],visitorCenter:{name:"Little Visitor Center",info:"The main visitor contact point, providing maps, informational brochures, and educational displays.",phone:"(256) 845-9605"},rangerPrograms:["Daily Ranger-led Educational Talks","Junior Ranger Activity Programs"],campingInfo:"NPS lists no camping at this site.",wildlife:["Herons","Bald Eagles","Osprey","River Otters"],bestViewpoints:["Main Overlook","Visitor Center Observation Deck"],entranceFees:"Private Vehicle $15 (per nps.gov)",hours:"The main park is open during daylight hours every day including holidays.",address:"Alabama, USA",googleMapsLocation:"https://maps.google.com/?q=Little%20River%20Canyon%20National%20Preserve",officialWebsite:"https://www.nps.gov/liri/index.htm",bestTimeToVisit:"Spring and Autumn (mild weather)",accessibilityInfo:"The visitor center and several designated viewing platforms/trails are fully wheelchair accessible.",travelTips:["Check the official NPS website before visiting for current weather and conditions.","Carry plenty of drinking water and pack out all trash."],nearbyAttractions:[],designation:"National Recreation Area"},{id:"tuskegee-airmen-national-historic-site",name:"Tuskegee Airmen National Historic Site",image:"https://www.nps.gov/common/uploads/structured_data/3C87CA3F-1DD8-B71B-0B1A6DBC5E5DF262.jpg",photoGallery:[],shortDescription:"This historic site commemorates the heroic achievements of the Tuskegee Airmen, the first African American military aviators in the U.S. armed forces, who trained at Moton Field during World War II and paved the way for desegregation. It tells the inspiring story of their fight against both foreign enemies and racial prejudice at home.",fullDescription:"Located at Moton Field, where the Tuskegee Airmen received their primary flight training, the historic site preserves the airfield, hangars, and other structures integral to their story. These trailblazing pilots, navigators, and ground crews overcame immense racial discrimination to serve with distinction during WWII, demonstrating their exceptional skill and courage in combat. Their success played a crucial role in President Truman's decision to desegregate the U.S. military in 1948, leaving an indelible mark on American history and the ongoing struggle for civil rights.",thingsToDo:["Sightseeing","Photography","Guided Walks","Wildlife Viewing","Historical Exhibits","Ranger Talks"],hikingTrails:[],scenicDrives:[],visitorCenter:{name:"Tuskegee Visitor Center",info:"The main visitor contact point, providing maps, informational brochures, and educational displays.",phone:"(334) 724-6094"},rangerPrograms:["Daily Ranger-led Educational Talks","Junior Ranger Activity Programs"],campingInfo:"NPS lists no camping at this site.",wildlife:["Deer","Red-tailed Hawks","Songbirds","Coyotes"],bestViewpoints:["Main Overlook","Visitor Center Observation Deck"],entranceFees:"Free (no entrance fee)",hours:"The park is open Monday-Saturday 9:00 am - 4:30 pm CST. The park is closed Thanksgiving Day, Christmas Day, and New Year's Day.",address:"Alabama, USA",googleMapsLocation:"https://maps.google.com/?q=Tuskegee%20Airmen%20National%20Historic%20Site",officialWebsite:"https://www.nps.gov/tuai/index.htm",bestTimeToVisit:"Spring and Autumn (mild weather)",accessibilityInfo:"The visitor center and several designated viewing platforms/trails are fully wheelchair accessible.",travelTips:["Check the official NPS website before visiting for current weather and conditions.","Carry plenty of drinking water and pack out all trash."],nearbyAttractions:[],designation:"National Historic Site"},{id:"tuskegee-institute-national-historic-site",name:"Tuskegee Institute National Historic Site",image:"https://www.nps.gov/common/uploads/structured_data/3C880363-1DD8-B71B-0B19DE390A6D20CD.jpg",photoGallery:[],shortDescription:"This site preserves the historic campus of Tuskegee University, founded by Booker T. Washington, and tells the story of its profound impact on African American education, self-sufficiency, and agricultural innovation. It stands as a testament to the power of education in overcoming adversity.",fullDescription:"Tuskegee Institute National Historic Site includes the historic campus buildings, such as The Oaks (Booker T. Washington's home) and the George Washington Carver Museum. Established in 1881, the institute became a beacon of education and vocational training for African Americans in the post-Reconstruction era, promoting self-help and economic advancement. Under the leadership of figures like Booker T. Washington and agricultural scientist George Washington Carver, Tuskegee developed groundbreaking agricultural techniques and educational philosophies that continue to influence communities worldwide.",thingsToDo:["Sightseeing","Photography","Guided Walks","Wildlife Viewing","Historical Exhibits","Ranger Talks"],hikingTrails:[],scenicDrives:[],visitorCenter:{name:"Tuskegee Visitor Center",info:"The main visitor contact point, providing maps, informational brochures, and educational displays.",phone:"(334) 727-3200"},rangerPrograms:["Daily Ranger-led Educational Talks","Junior Ranger Activity Programs"],campingInfo:"NPS lists no camping at this site.",wildlife:["Deer","Red-tailed Hawks","Songbirds","Coyotes"],bestViewpoints:["Main Overlook","Visitor Center Observation Deck"],entranceFees:"Free (no entrance fee)",hours:"Tuskegee Insitute National Historic Site, admission is free for all visitors.",address:"Alabama, USA",googleMapsLocation:"https://maps.google.com/?q=Tuskegee%20Institute%20National%20Historic%20Site",officialWebsite:"https://www.nps.gov/tuin/index.htm",bestTimeToVisit:"Spring and Autumn (mild weather)",accessibilityInfo:"The visitor center and several designated viewing platforms/trails are fully wheelchair accessible.",travelTips:["Check the official NPS website before visiting for current weather and conditions.","Carry plenty of drinking water and pack out all trash."],nearbyAttractions:[],designation:"National Historic Site"},{id:"horseshoe-bend-national-military-park",name:"Horseshoe Bend National Military Park",image:"https://kosher-travel-img.sites.tab.bot/wm/72a2103138b61a16.webp",photoGallery:[],shortDescription:"Horseshoe Bend National Military Park commemorates the decisive 1814 Battle of Horseshoe Bend, where Major General Andrew Jackson's forces defeated the Creek Nation Red Sticks, significantly altering the course of American expansion and Native American history. It preserves the battlefield and interprets its profound impact on the Southeastern tribes.",fullDescription:"Located on the Tallapoosa River, this park preserves the site of the pivotal Battle of Horseshoe Bend, the final engagement of the Creek War. On March 27, 1814, Andrew Jackson's Tennessee militia, along with allied Cherokee and Lower Creek warriors, inflicted a devastating defeat on the Upper Creek Red Sticks. This battle led to the Treaty of Fort Jackson, ceding vast tracts of Creek land to the United States and paving the way for further westward expansion. The park offers trails, a scenic drive, and exhibits that interpret the battle and its lasting consequences for all involved.",thingsToDo:["Sightseeing","Photography","Guided Walks","Wildlife Viewing","Hiking","Nature Trails"],hikingTrails:[],scenicDrives:[],visitorCenter:{name:"Horseshoe Visitor Center",info:"The main visitor contact point, providing maps, informational brochures, and educational displays.",phone:"(256) 234-7111"},rangerPrograms:["Daily Ranger-led Educational Talks","Junior Ranger Activity Programs"],campingInfo:"NPS lists no camping at this site.",wildlife:["Deer","Red-tailed Hawks","Songbirds","Coyotes"],bestViewpoints:["Main Overlook","Visitor Center Observation Deck"],entranceFees:"Free (no entrance fee)",hours:"Park grounds, trails, and picnic areas, are open from 8:00 a.m. - 5:00 p.m.",address:"Alabama, USA",googleMapsLocation:"https://maps.google.com/?q=Horseshoe%20Bend%20National%20Military%20Park",officialWebsite:"https://www.nps.gov/hobe/index.htm",bestTimeToVisit:"Spring and Autumn (mild weather)",accessibilityInfo:"The visitor center and several designated viewing platforms/trails are fully wheelchair accessible.",travelTips:["Check the official NPS website before visiting for current weather and conditions.","Carry plenty of drinking water and pack out all trash."],nearbyAttractions:[],designation:"National Historic Site"},{id:"natchez-trace-parkway",name:"Natchez Trace Parkway",image:"https://www.nps.gov/common/uploads/structured_data/3C80016C-1DD8-B71B-0B91B2FA75DF0C02.jpg",photoGallery:["https://www.nps.gov/common/uploads/structured_data/3C7FFB07-1DD8-B71B-0B35C15D0834A556.jpg","https://www.nps.gov/common/uploads/structured_data/3C7FFE3F-1DD8-B71B-0B9E86CB3BBD9041.jpg"],shortDescription:"The Natchez Trace Parkway is a 444-mile scenic road and historic corridor connecting Natchez, Mississippi, to Nashville, Tennessee, preserving centuries of history from Native American routes to early American frontier travel. It offers a journey through diverse natural landscapes and archaeological sites across three states.",fullDescription:'This federal parkway follows the route of the "Old Natchez Trace," an ancient path used by Native Americans, European settlers, and Kaintucks (boatmen returning north from Natchez). It offers a unique driving experience free of commercial vehicles, with numerous interpretive stops, hiking trails, and picnic areas along its length. The parkway showcases significant cultural sites, including ancient Indian mounds, Civil War battlefields, and historic homesteads, all while protecting diverse ecosystems and offering a tranquil escape through the American South.',thingsToDo:["Sightseeing","Photography","Guided Walks","Wildlife Viewing","Historical Exhibits","Ranger Talks"],hikingTrails:[{name:"Hiking the Blackland Prairie Section of the Natchez Trace National Scenic Trail",difficulty:"See nps.gov",length:"1-6 Hours",description:"The Blackland Prairie section of the Natchez Trace National Scenic Trail is a popular 6 mile hiking trail in and around Tupelo, Mississippi."},{name:"Hiking the Yockanookany Section of the Natchez Trace National Scenic Trail",difficulty:"See nps.gov",length:"1-15 Hours",description:"North of Jackson, Mississippi the Yockanookany section of the Natchez Trace National Scenic Trail is the longest of the five developed trail sections at 26 miles. Eight miles run alongside the Ross R. Barnett Reservoir, "},{name:"Hiking the Highland Rim Section of the Natchez Trace National Scenic Trail",difficulty:"See nps.gov",length:"1-10 Hours",description:"The Highland Rim section of the Natchez Trace National Scenic Trail is a popular twenty mile hiking and equestrian corridor south of Nashville Tennessee along the Natchez Trace Parkway from Milepost 427.4 to 407.9."}],scenicDrives:[],visitorCenter:{name:"Natchez Visitor Center",info:"The main visitor contact point, providing maps, informational brochures, and educational displays.",phone:"(662) 680-4027"},rangerPrograms:["Daily Ranger-led Educational Talks","Junior Ranger Activity Programs"],campingInfo:"NPS lists camping here; see nps.gov for campgrounds and reservations.",wildlife:["Deer","Red-tailed Hawks","Songbirds","Coyotes"],bestViewpoints:["Main Overlook","Visitor Center Observation Deck"],entranceFees:"Free (no entrance fee)",hours:"Open 24 hours a day (per nps.gov; visitor center hours vary)",address:"Alabama and Mississippi and Tennessee, USA",googleMapsLocation:"https://maps.google.com/?q=Natchez%20Trace%20Parkway",officialWebsite:"https://www.nps.gov/natr/index.htm",bestTimeToVisit:"Spring and Autumn (mild weather)",accessibilityInfo:"The visitor center and several designated viewing platforms/trails are fully wheelchair accessible.",travelTips:["Check the official NPS website before visiting for current weather and conditions.","Carry plenty of drinking water and pack out all trash."],nearbyAttractions:[],designation:"National Recreation Area"},{id:"selma-to-montgomery-national-historic-trail",name:"Selma to Montgomery National Historic Trail",image:"https://kosher-travel-img.sites.tab.bot/wm/8a68131940107945.webp",photoGallery:[],shortDescription:"This 54-mile trail commemorates the historic 1965 voting rights marches from Selma to Montgomery, Alabama, a pivotal moment in the Civil Rights Movement that directly led to the passage of the Voting Rights Act. It invites visitors to walk in the footsteps of those who fought for justice and equality.",fullDescription:'The Selma to Montgomery National Historic Trail preserves the route of the three voting rights marches of March 1965, during which civil rights activists, led by figures like Martin Luther King Jr., bravely protested for the right to vote. The events, including the brutal 