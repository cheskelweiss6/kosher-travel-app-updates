him.",thingsToDo:["Sightseeing","Photography","Guided Walks","Wildlife Viewing","Historical Exhibits","Ranger Talks"],hikingTrails:[],scenicDrives:[],visitorCenter:{name:"Theodore Visitor Center",info:"The main visitor contact point, providing maps, informational brochures, and educational displays.",phone:"(212) 260-1616"},rangerPrograms:["Daily Ranger-led Educational Talks","Junior Ranger Activity Programs"],campingInfo:"NPS lists no camping at this site.",wildlife:["Deer","Red-tailed Hawks","Songbirds","Coyotes"],bestViewpoints:["Main Overlook","Visitor Center Observation Deck"],entranceFees:"Free (no entrance fee)",hours:"Theodore Roosevelt Birthplace National Historic Site is open Wednesday through Sunday. The park is open on federal holidays except for the following: Thanksgiving Day, Christmas Day & New Year's Day.",address:"New york, USA",googleMapsLocation:"https://maps.google.com/?q=Theodore%20Roosevelt%20Birthplace%20National%20Historic%20Site",officialWebsite:"https://www.nps.gov/thrb",bestTimeToVisit:"Spring and Autumn (mild weather)",accessibilityInfo:"The visitor center and several designated viewing platforms/trails are fully wheelchair accessible.",travelTips:["Check the official NPS website before visiting for current weather and conditions.","Carry plenty of drinking water and pack out all trash."],nearbyAttractions:[],designation:"National Historic Site"},{id:"theodore-roosevelt-inaugural-national-historic-site",name:"Theodore Roosevelt Inaugural National Historic Site",image:"https://www.nps.gov/common/uploads/structured_data/3C7BD805-1DD8-B71B-0B1E51DD10FB6FAA.jpg",photoGallery:[],shortDescription:"Preserves the Ansley Wilcox House in Buffalo, where Theodore Roosevelt took the presidential oath of office in 1901.",fullDescription:"Theodore Roosevelt Inaugural National Historic Site preserves the elegant Ansley Wilcox House in Buffalo, New York. On September 14, 1901, following the tragic assassination of President William McKinley, Theodore Roosevelt was hastily sworn in here as the 26th President of the United States. The site features highly interactive exhibits, restored historic rooms, and multimedia presentations that transport visitors back to that chaotic moment of national transition and explore the progressive reforms of TR's presidency.",thingsToDo:["Sightseeing","Photography","Guided Walks","Wildlife Viewing","Historical Exhibits","Ranger Talks"],hikingTrails:[],scenicDrives:[],visitorCenter:{name:"Theodore Visitor Center",info:"The main visitor contact point, providing maps, informational brochures, and educational displays.",phone:"(716) 884-0095"},rangerPrograms:["Daily Ranger-led Educational Talks","Junior Ranger Activity Programs"],campingInfo:"NPS lists no camping at this site.",wildlife:["Deer","Red-tailed Hawks","Songbirds","Coyotes"],bestViewpoints:["Main Overlook","Visitor Center Observation Deck"],entranceFees:"Timed Entry Reservation - Location $12 (per nps.gov)",hours:"Museum visit is by guided tour only. Tours begin every hour at the bottom of the hour, starting at 9:30 a.m.",address:"New york, USA",googleMapsLocation:"https://maps.google.com/?q=Theodore%20Roosevelt%20Inaugural%20National%20Historic%20Site",officialWebsite:"https://www.nps.gov/thri",bestTimeToVisit:"Spring and Autumn (mild weather)",accessibilityInfo:"The visitor center and several designated viewing platforms/trails are fully wheelchair accessible.",travelTips:["Check the official NPS website before visiting for current weather and conditions.","Carry plenty of drinking water and pack out all trash."],nearbyAttractions:[],designation:"National Historic Site"},{id:"thomas-cole-national-historic-site",name:"Thomas Cole National Historic Site",image:"https://kosher-travel-img.sites.tab.bot/wm/fecac8fdad38d5d3.webp",photoGallery:["https://www.nps.gov/common/uploads/structured_data/2D6C2E4A-F955-7538-5ADB7DB4A8539BF9.jpg"],shortDescription:'Preserves "Cedar Grove," the home and studio of Thomas Cole, the founder of the Hudson River School of American landscape painting.',fullDescription:`The Thomas Cole National Historic Site preserves "Cedar Grove," the scenic home, gardens, and active painting studio of Thomas Cole in Catskill, New York. Cole, widely recognized as the founder of the Hudson River School of painting, lived and worked here, drawing deep inspiration from the local Catskill Mountains and Hudson River. The site features Cole's historic house, his meticulously restored studio, original landscape paintings, and interactive exhibits exploring the birth of American art and early environmental conservation.`,thingsToDo:["Sightseeing","Photography","Guided Walks","Wildlife Viewing","Historical Exhibits","Ranger Talks"],hikingTrails:[{name:"Hudson River Art Trail",difficulty:"See nps.gov",length:"See nps.gov",description:"The Hudson River School Art Trail connects you with the places in nature that Thomas Cole and the Hudson River School artists made famous in their 19th-century landscape paintings. Cole founded this nation’s first major "}],scenicDrives:[],visitorCenter:{name:"Thomas Visitor Center",info:"The main visitor contact point, providing maps, informational brochures, and educational displays.",phone:"(518) 943-7465"},rangerPrograms:["Daily Ranger-led Educational Talks","Junior Ranger Activity Programs"],campingInfo:"NPS lists no camping at this site.",wildlife:["Deer","Red-tailed Hawks","Songbirds","Coyotes"],bestViewpoints:["Main Overlook","Visitor Center Observation Deck"],entranceFees:"Free (no entrance fee)",hours:"Open 24 hours a day (per nps.gov; visitor center hours vary)",address:"New york, USA",googleMapsLocation:"https://maps.google.com/?q=Thomas%20Cole%20National%20Historic%20Site",officialWebsite:"https://www.nps.gov/thco",bestTimeToVisit:"Spring and Autumn (mild weather)",accessibilityInfo:"The visitor center and several designated viewing platforms/trails are fully wheelchair accessible.",travelTips:["Check the official NPS website before visiting for current weather and conditions.","Carry plenty of drinking water and pack out all trash."],nearbyAttractions:[],designation:"National Historic Site"},{id:"vanderbilt-mansion-national-historic-site",name:"Vanderbilt Mansion National Historic Site",image:"https://www.nps.gov/common/uploads/structured_data/3C810EB8-1DD8-B71B-0BE87CD40E856268.jpg",photoGallery:["https://www.nps.gov/common/uploads/structured_data/3C810EB8-1DD8-B71B-0BE87CD40E856268.jpg","https://www.nps.gov/common/uploads/structured_data/3C811008-1DD8-B71B-0B83B94A806778B3.jpg","https://www.nps.gov/common/uploads/structured_data/3C81117C-1DD8-B71B-0BDD0C3E90741B37.jpg"],shortDescription:"A spectacular Gilded Age country estate designed by McKim, Mead & White, showcasing the wealth of the Vanderbilt family.",fullDescription:"Vanderbilt Mansion National Historic Site in Hyde Park, New York, preserves a premier example of a Gilded Age country estate. Designed by the legendary architectural firm McKim, Mead & White and completed in 1899 for Frederick William Vanderbilt, the 54-room Beaux-Arts mansion features opulent classical interiors, exquisite Italian marbles, and antique tapestries. The estate sits on 211 acres of manicured lawns, formal Italian gardens, and scenic overlook paths offering breathtaking views of the Hudson River and Catskill Mountains.",thingsToDo:["Sightseeing","Photography","Guided Walks","Wildlife Viewing","Historical Exhibits","Ranger Talks"],hikingTrails:[{name:"Hudson River Art Trail",difficulty:"See nps.gov",length:"See nps.gov",description:"The Hudson River School Art Trail connects you with the places in nature that Thomas Cole and the Hudson River School artists made famous in their 19th-century landscape paintings. Cole founded this nation’s first major "}],scenicDrives:[],visitorCenter:{name:"Vanderbilt Visitor Center",info:"The main visitor contact point, providing maps, informational brochures, and educational displays.",phone:"(845) 444-9166"},rangerPrograms:["Daily Ranger-led Educational Talks","Junior Ranger Activity Programs"],campingInfo:"NPS lists no camping at this site.",wildlife:["Deer","Red-tailed Hawks","Songbirds","Coyotes"],bestViewpoints:["Main Overlook","Visitor Center Observation Deck"],entranceFees:"Per Person $15 (per nps.gov)",hours:"During the winter and spring months, tours of the Mansion are offered daily. The first tour usually starts at 10 AM with the last tour starting at 3:30 PM.",address:"New york, USA",googleMapsLocation:"https://maps.google.com/?q=Vanderbilt%20Mansion%20National%20Historic%20Site",officialWebsite:"https://www.nps.gov/vama",bestTimeToVisit:"Spring and Autumn (mild weather)",accessibilityInfo:"The visitor center and several designated viewing platforms/trails are fully wheelchair accessible.",travelTips:["Check the official NPS website before visiting for current weather and conditions.","Carry plenty of drinking water and pack out all trash."],nearbyAttractions:[],designation:"National Historic Site"},{id:"federal-hall-national-memorial",name:"Federal Hall National Memorial",image:"https://www.nps.gov/common/uploads/structured_data/840AF25C-FDBC-D874-E02D44C133D53705.jpg",photoGallery:[],shortDescription:"The historic site where George Washington was inaugurated, the Bill of Rights was introduced, and the U.S. government was born.",fullDescription:"Federal Hall National Memorial, situated on Wall Street in Lower Manhattan, is a stunning Greek Revival building standing on the historic site of the nation's first capitol. Here, on April 30, 1789, George Washington was inaugurated as the first President of the United States. The site also hosted the Stamp Act Congress, the introduction of the Bill of Rights, and the passage of the Northwest Ordinance. Today, the memorial features historical exhibits, Washington's inauguration Bible, and an iconic bronze statue of Washington on its front steps.",thingsToDo:["Sightseeing","Photography","Guided Walks","Wildlife Viewing","Historical Exhibits","Ranger Talks"],hikingTrails:[],scenicDrives:[],visitorCenter:{name:"Federal Visitor Center",info:"The main visitor contact point, providing maps, informational brochures, and educational displays.",phone:"(212) 825-6990"},rangerPrograms:["Daily Ranger-led Educational Talks","Junior Ranger Activity Programs"],campingInfo:"NPS lists no camping at this site.",wildlife:["Deer","Red-tailed Hawks","Songbirds","Coyotes"],bestViewpoints:["Main Overlook","Visitor Center Observation Deck"],entranceFees:"Free (no entrance fee)",hours:"Federal Hall is open Wednesday-Sunday from 10:00 AM to 4:00 PM. The visitor entrance is at 15 Pine St.",address:"New york, USA",googleMapsLocation:"https://maps.google.com/?q=Federal%20Hall%20National%20Memorial",officialWebsite:"https://www.nps.gov/feha",bestTimeToVisit:"Spring and Autumn (mild weather)",accessibilityInfo:"The visitor center and several designated viewing platforms/trails are fully wheelchair accessible.",travelTips:["Check the official NPS website before visiting for current weather and conditions.","Carry plenty of drinking water and pack out all trash."],nearbyAttractions:[],designation:"National Memorial"},{id:"hamilton-grange-national-memorial",name:"Hamilton Grange National Memorial",image:"https://www.nps.gov/common/uploads/structured_data/3C80DC70-1DD8-B71B-0B9CB85978295244.jpg",photoGallery:["https://www.nps.gov/common/uploads/structured_data/3C80E018-1DD8-B71B-0B6AA1EDE3500733.jpg","https://www.nps.gov/common/uploads/structured_data/3C80E176-1DD8-B71B-0BFB7C46CA9AF249.jpg"],shortDescription:'Preserves "The Grange," the only home ever owned by Founding Father and first Treasury Secretary Alexander Hamilton.',fullDescription:`Hamilton Grange National Memorial preserves the elegant, two-story Federal-style country home of Alexander Hamilton, the brilliant Founding Father, co-author of the Federalist Papers, and the first Secretary of the Treasury. Completed in 1802 in Upper Manhattan, "The Grange" was designed by architect John McComb Jr. and served as Hamilton's retreat for just two years before his tragic death in a duel with Aaron Burr in 1804. The historic house, which has been moved twice to preserve it, features beautifully restored period rooms and historical exhibits exploring Hamilton's massive legacy.`,thingsToDo:["Sightseeing","Photography","Guided Walks","Wildlife Viewing","Historical Exhibits","Ranger Talks"],hikingTrails:[],scenicDrives:[],visitorCenter:{name:"Hamilton Visitor Center",info:"The main visitor contact point, providing maps, informational brochures, and educational displays.",phone:"(646) 494-5366"},rangerPrograms:["Daily Ranger-led Educational Talks","Junior Ranger Activity Programs"],campingInfo:"NPS lists no camping at this site.",wildlife:["Deer","Red-tailed Hawks","Songbirds","Coyotes"],bestViewpoints:["Main Overlook","Visitor Center Observation Deck"],entranceFees:"Free (no entrance fee)",hours:"On Wednesdays, Thursdays and Fridays, tours are offered at 11:30, 1:30 and 3:30. On Saturdays and Sundays, tours will be offered at 10:30, 11:30, 1:30, 2:30 and 3:30.",address:"New york, USA",googleMapsLocation:"https://maps.google.com/?q=Hamilton%20Grange%20National%20Memorial",officialWebsite:"https://www.nps.gov/hagr",bestTimeToVisit:"Spring and Autumn (mild weather)",accessibilityInfo:"The visitor center and several designated viewing platforms/trails are fully wheelchair accessible.",travelTips:["Check the official NPS website before visiting for current weather and conditions.","Carry plenty of drinking water and pack out all trash."],nearbyAttractions:[],designation:"National Memorial"},{id:"gateway-national-recreation-area",name:"Gateway National Recreation Area",image:"https://www.nps.gov/common/uploads/structured_data/3C852619-1DD8-B71B-0B6D168C73AFBBA8.jpg",photoGallery:["https://www.nps.gov/common/uploads/structured_data/67DE67F5-CEB2-5C37-46715922D962EB8E.jpg","https://www.nps.gov/common/uploads/structured_data/3C852619-1DD8-B71B-0B6D168C73AFBBA8.jpg"],shortDescription:"A sprawling 27,000-acre coastal park spanning New York and New Jersey, protecting scenic beaches, wildlife refuges, and historic forts.",fullDescription:"Gateway National Recreation Area is a massive 27,000-acre coastal sanctuary spanning three distinct units in New York (Jamaica Bay, Staten Island) and Sandy Hook, New Jersey. The park protects critical salt marshes, maritime forests, ocean beaches, and historic military installations like Fort Tilden and Fort Hancock. Sandy Hook is also home to the historic Sandy Hook Lighthouse, the oldest continuously operating lighthouse in the United States (established in 1764). The park offers exceptional opportunities for swimming, biking, fishing, and birdwatching, as well as preserving vital coastal ecosystems.",thingsToDo:["Sightseeing","Photography","Guided Walks","Wildlife Viewing","Hiking","Nature Trails"],hikingTrails:[],scenicDrives:[],visitorCenter:{name:"Gateway Visitor Center",info:"The main visitor contact point, providing maps, informational brochures, and educational displays.",phone:"(718) 354-4606"},rangerPrograms:["Daily Ranger-led Educational Talks","Junior Ranger Activity Programs"],campingInfo:"NPS lists camping here; see nps.gov for campgrounds and reservations.",wildlife:["Deer","Red-tailed Hawks","Songbirds","Coyotes"],bestViewpoints:["Main Overlook","Visitor Center Observation Deck"],entranceFees:"Free (no entrance fee)",hours:"Includes Bergen Beach, Floyd Bennett Field, Fort Tilden, Frank Charles Park, Hamilton Beach, Jamaica Bay Wildlife Refuge, Canarsie Pier, Jacob Riis Park, North Channel Bridge, Plumb Beach and Spring Creek.",address:"New jersey and New york, USA",googleMapsLocation:"https://maps.google.com/?q=Gateway%20National%20Recreation%20Area",officialWebsite:"https://www.nps.gov/gate",bestTimeToVisit:"Spring and Autumn (mild weather)",accessibilityInfo:"The visitor center and several designated viewing platforms/trails are fully wheelchair accessible.",travelTips:["Check the official NPS website before visiting for current weather and conditions.","Carry plenty of drinking water and pack out all trash."],nearbyAttractions:[],designation:"National Recreation Area"},{id:"fire-island-national-seashore",name:"Fire Island National Seashore",image:"https://www.nps.gov/common/uploads/structured_data/36851BAB-E864-649F-D190A838BF95C5D5.jpg",photoGallery:[],shortDescription:"A pristine 26-mile barrier island protecting rare maritime forests, dynamic sand dunes, and historic coastal lighthouses.",fullDescription:"Fire Island National Seashore protects a spectacular, largely undeveloped 26-mile-long barrier island off the south shore of Long Island, New York. Famed for its dynamic sand dunes, historic maritime holly forests, and pristine Atlantic beaches, the park offers a car-free escape for outdoor lovers. Visitors can hike the boardwalks of the Sunken Forest, explore historic coastal communities, climb the 1858 Fire Island Lighthouse, and canoe through tranquil salt marshes, preserving a crucial ecological barrier for the mainland.",thingsToDo:["Sightseeing","Photography","Guided Walks","Wildlife Viewing","Kayaking","Swimming"],hikingTrails:[{name:"Burma Trail",difficulty:"See nps.gov",length:"See nps.gov",description:"Burma Trail is a seven-mile-long footpath that spans the Otis Pike Fire Island High Dune Wilderness Area from Watch Hill to Smith Point and allows access to Fire Island's Wilderness for hikers, photographers, birders, ca"}],scenicDrives:[],visitorCenter:{name:"Fire Visitor Center",info:"The main visitor contact point, providing maps, informational brochures, and educational displays.",phone:"(631) 515-5557"},rangerPrograms:["Daily Ranger-led Educational Talks","Junior Ranger Activity Programs"],campingInfo:"NPS lists camping here; see nps.gov for campgrounds and reservations.",wildlife:["Herons","Bald Eagles","Osprey","River Otters"],bestViewpoints:["Main Overlook","Visitor Center Observation Deck"],entranceFees:"Free (