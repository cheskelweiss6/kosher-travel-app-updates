ties.",thingsToDo:["Sightseeing","Photography","Guided Walks","Wildlife Viewing","Kayaking","Swimming"],hikingTrails:[{name:"Hike Castle Windy Trail",difficulty:"Easy",length:"See nps.gov",description:"Castle Windy Trail is located in Canaveral National Seashore's Apollo Beach. Park at beach parking area number three to access the trail. The trail is on the west side of the road and leads a half mile to Mosquito Lagoon"}],scenicDrives:[],visitorCenter:{name:"Canaveral Visitor Center",info:"The main visitor contact point, providing maps, informational brochures, and educational displays.",phone:"(386) 428-3384"},rangerPrograms:["Daily Ranger-led Educational Talks","Junior Ranger Activity Programs"],campingInfo:"NPS lists camping here; see nps.gov for campgrounds and reservations.",wildlife:["Herons","Bald Eagles","Osprey","River Otters"],bestViewpoints:["Main Overlook","Visitor Center Observation Deck"],entranceFees:"Private Vehicle $25; Per Person $15 (per nps.gov)",hours:"Canaveral National Seashore is open 7 days a week. Visitor hours are 6:00 am to 6:00 pm.",address:"Florida, USA",googleMapsLocation:"https://maps.google.com/?q=Canaveral%20National%20Seashore",officialWebsite:"https://www.nps.gov/cana/",bestTimeToVisit:"Spring and Autumn (mild weather)",accessibilityInfo:"The visitor center and several designated viewing platforms/trails are fully wheelchair accessible.",travelTips:["Check the official NPS website before visiting for current weather and conditions.","Carry plenty of drinking water and pack out all trash."],nearbyAttractions:[],designation:"National Seashore/Lakeshore"},{id:"gulf-islands-national-seashore",name:"Gulf Islands National Seashore",image:"https://www.nps.gov/common/uploads/structured_data/CECB6504-E46D-110F-AC4A39D32488193B.jpg",photoGallery:["https://www.nps.gov/common/uploads/structured_data/CF8AA22D-A3C2-8DBE-98F1255BBA16CE3C.jpg","https://www.nps.gov/common/uploads/structured_data/CE2187A2-F3AF-54FA-06EFF4660752902F.jpg","https://www.nps.gov/common/uploads/structured_data/CECB6504-E46D-110F-AC4A39D32488193B.jpg","https://www.nps.gov/common/uploads/structured_data/CF532898-AD17-5265-F3C3891182FEE203.jpg"],shortDescription:"Gulf Islands National Seashore is located primarily in Florida, with portions extending into other states. Please refer to the Florida entry for complete details.",fullDescription:"This entry represents the portion of Gulf Islands National Seashore located in this state. The park is famously known and managed as a single unit. For complete itineraries, visitor centers, hiking trails, camping info, and travel guides, please select Florida from the browse states list.",thingsToDo:["Sightseeing","Photography","Guided Walks","Wildlife Viewing","Kayaking","Swimming"],hikingTrails:[],scenicDrives:[],visitorCenter:{name:"Gulf Islands National Seashore Visitor Information",info:"Please select Florida for visitor center information and contact details.",hours:"Varies",phone:"(850) 934-2600"},rangerPrograms:[],campingInfo:"Refer to main state profile.",wildlife:[],bestViewpoints:[],entranceFees:"Private Vehicle $25; Per Person $15 (per nps.gov)",hours:"The Davis Bayou Area is located south of U. S.",address:"Florida and Mississippi, USA",googleMapsLocation:"https://maps.google.com/?q=Gulf%20Islands%20National%20Seashore",officialWebsite:"https://www.nps.gov/guis",bestTimeToVisit:"Year-round",accessibilityInfo:"Varies.",travelTips:["Select Florida to view comprehensive itineraries and details."],nearbyAttractions:[],designation:"National Seashore/Lakeshore"}],georgia:[{id:"fort-frederica-national-monument",name:"Fort Frederica National Monument",image:"https://www.nps.gov/common/uploads/structured_data/3C7DD350-1DD8-B71B-0BF0B4C77628ED80.jpg",photoGallery:[],shortDescription:"Fort Frederica National Monument preserves the archaeological remnants of a British fort and town established in 1736 to defend Georgia's southern frontier against Spanish invasion. It offers a glimpse into 18th-century colonial life and strategic military efforts.",fullDescription:"Built by James Oglethorpe, Fort Frederica was a vital military outpost and the largest British fort in North America at the time, successfully repelling Spanish forces during the Battle of Bloody Marsh. Visitors can explore the archaeological remains of the fort and town, stroll along the scenic Frederica River, and learn about the diverse inhabitants who lived and worked here, including soldiers, craftsmen, and their families. The site provides a compelling narrative of early Georgia's struggle for survival and its role in the larger Anglo-Spanish imperial rivalry.",thingsToDo:["Sightseeing","Photography","Guided Walks","Wildlife Viewing","Historical Exhibits","Ranger Talks"],hikingTrails:[{name:"Hike a Nature Trail",difficulty:"See nps.gov",length:"See nps.gov",description:"A few miles of nature trails surrounding the Fort Frederica town site gives visitors the opportunity to stretch their legs. Numbered posts along the trail identify plants and other nature features. Pick up a Nature Trail"}],scenicDrives:[],visitorCenter:{name:"Fort Visitor Center",info:"The main visitor contact point, providing maps, informational brochures, and educational displays.",phone:"(912) 638-3639"},rangerPrograms:["Daily Ranger-led Educational Talks","Junior Ranger Activity Programs"],campingInfo:"NPS lists no camping at this site.",wildlife:["Deer","Red-tailed Hawks","Songbirds","Coyotes"],bestViewpoints:["Main Overlook","Visitor Center Observation Deck"],entranceFees:"Free (no entrance fee)",hours:`Park & Grounds Closed:

